# Backend only. Copy settings into auth/.env; never commit credentials.
HOST=127.0.0.1
PORT=8790
SESSION_SECRET=
ALLOWED_EMAIL_DOMAINS=kcis.com.tw,kcis.ntpc.edu.tw
# Exact optional test-account exceptions. Set empty to disable.
EXTRA_ALLOWED_EMAILS=chaos60649@gmail.com,st101031616@gmail.com
EXTRA_TEACHER_EMAILS=chaos60649@gmail.com
FRONTEND_ORIGINS=https://ai-tools.school.example,https://wikinb.school.example
AUTH_BASE_URL=https://api.school.example
# Persistent files; default is PROJECT_ROOT/data/library.
LIBRARY_DATA_DIR=
WIKINB_INGEST_SECRET=
DEV_LOG_CODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Verified sender address or approved Send As alias; distinct from SMTP_USER.
SMTP_FROM=
LLM_PROVIDER=gemini
GEMINI_API_MODE=apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# Optional restricted public ingress. Configure with the approved deployment.
SCHOOL_PRIVATE_API=http://127.0.0.1:8790
SCHOOL_GATEWAY_PORT=8791
SCHOOL_PUBLIC_API_ORIGIN=

GEMINI_THINKING_LEVEL=minimal
AI_FIRST_TOKEN_TIMEOUT_MS=25000
AI_REQUEST_TIMEOUT_MS=45000
# One visible retry for HTTP 503 before any output; delay is bounded to 10–3000 ms.
AI_BUSY_RETRY_DELAY_MS=1000

# Forum Worker URL: required for account metadata and historical-copy sync.
# Use HTTPS in deployment; localhost HTTP is accepted for isolated development.
FORUM_API_URL=
