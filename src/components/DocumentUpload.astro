---
const base = import.meta.env.BASE_URL;
---
<section class="document-upload">
  <header class="upload-heading"><h1 data-i18n="upload.title">Upload documents</h1></header>
  <div class="upload-choices">
    <button id="upload-open" type="button" class="upload-choice" aria-expanded="false" aria-controls="upload-panel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v5h16v-5"/></svg>
      <span data-i18n="upload.card">Upload MD</span>
    </button>
    <button id="upload-help-open" type="button" class="upload-choice" aria-expanded="false" aria-controls="upload-help-panel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6v20h12V6l-4-4Z"/><path d="M14 2v5h4M9 12h6M9 16h6"/></svg>
      <span data-i18n="upload.how">How to upload MD</span>
    </button>
  </div>
  <div id="upload-panel" class="upload-panel" hidden>
  <div id="upload-gate" class="kc-card" hidden><p data-i18n="upload.gate">Sign in with a teacher account to upload documents.</p><a href={`${base}login`} data-school-signin class="kc-btn-primary" data-i18n="nav.login">Sign in</a></div>
  <form id="document-upload-form" hidden>
    <button id="upload-dropzone" class="upload-dropzone" type="button">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v5h16v-5" /></svg>
      <strong data-i18n="upload.drop">Drop files or choose files</strong>
      <span data-i18n="upload.formats">MD · 1 MB per file</span>
    </button>
    <p class="mt-3 text-sm text-kc-muted" data-i18n="upload.conversionUnavailable">PDF/DOCX conversion is currently unavailable.</p>
    <input id="upload-files" type="file" accept=".md" multiple hidden />
    <div class="upload-keywords"><label for="upload-keywords" data-i18n="upload.keywords">Keywords</label><div id="upload-author" class="tag-badge"></div><input id="upload-keywords" data-i18n-placeholder="upload.optional" placeholder="Optional keywords, separated by commas" maxlength="520" /></div>
    <ul id="upload-queue" data-i18n-aria="upload.selected" aria-label="Selected files"></ul>
    <div class="upload-actions"><button id="upload-submit" type="submit" class="kc-btn-primary" disabled data-i18n="upload.submit">Upload</button><button id="upload-clear" type="button" class="kc-btn-ghost" hidden data-i18n="upload.clear">Clear</button></div>
  </form>
  <p id="upload-status" role="status" aria-live="polite"></p>
  </div>
  <aside id="upload-help-panel" class="upload-panel upload-help" hidden>
    <p class="upload-intro" data-i18n="upload.intro">MD (Markdown) is a common plain-text format that keeps headings, lists, and tables organized. AI can help turn your existing materials into MD.</p>
    <section class="upload-prompt" aria-labelledby="upload-prompt-title">
      <div class="upload-prompt-heading"><h2 id="upload-prompt-title" data-i18n="upload.promptTitle">Prepare MD</h2><button id="upload-copy-prompt" type="button" class="upload-copy" data-i18n-aria="upload.copy" aria-label="Copy"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V3H3v13h5"/></svg><span id="upload-copy-label" data-i18n="upload.copy">Copy</span></button></div>
      <textarea id="upload-prompt-text" readonly rows="9" data-i18n-aria="upload.promptTitle" aria-label="Prepare MD" spellcheck="false"></textarea>
      <p id="upload-copy-status" class="upload-copy-status sr-only" role="status" aria-live="polite"></p>
    </section>
    <ol class="upload-guide upload-steps">
      <li data-i18n="upload.stepCopy">Copy the prompt above.</li>
      <li data-i18n="upload.stepKuse">Open Kuse × 康軒, upload your files, and paste the prompt.</li>
      <li data-i18n="upload.stepDownload">Download the .md file from Kuse.</li>
      <li data-i18n="upload.stepReturn">Return here and choose Upload MD to upload it.</li>
    </ol>
    <div class="upload-links">
      <a href="https://kuse.knsh.com.tw/" target="_blank" rel="noopener noreferrer" class="upload-link-button upload-partner upload-kuse"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15"/></svg><span data-i18n="upload.partner">Kuse × 康軒</span></a>
    </div>
  </aside>
</section>
<script>
  import '../scripts/document-upload.js';
</script>
<style>
  .document-upload{max-width:760px;margin:12px auto}.upload-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:28px;animation:kc-rise .9s var(--ease) backwards}.upload-heading h1{font-family:Comfortaa,Nunito,'Noto Sans TC',sans-serif;font-size:clamp(25px,4vw,34px);font-weight:700;letter-spacing:-.02em;color:var(--ink)}
  #upload-gate{padding:28px}#upload-gate p{margin-bottom:18px;color:var(--ink-2)}
  .upload-dropzone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;width:100%;min-height:230px;border:1.5px dashed rgba(123,47,143,.32);border-radius:24px;color:var(--ink);background:linear-gradient(145deg,var(--tint-rose),transparent 44%),rgba(255,255,255,.5);-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);cursor:pointer;transition:background-color .2s,border-color .2s,transform .4s var(--ease)}.upload-dropzone svg{color:var(--plum)}.upload-dropzone:hover,.upload-dropzone.is-dragging,.upload-dropzone:active{background-color:rgba(255,255,255,.78);border-color:rgba(144,0,128,.5)}.upload-dropzone.is-dragging{transform:translateY(-2px)}.upload-dropzone:disabled{cursor:wait;opacity:.7}.upload-dropzone:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.upload-dropzone strong{font-size:18px;font-weight:800}.upload-dropzone span{font-family:'DM Mono',Nunito,'Noto Sans TC',monospace;font-size:11.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
  .upload-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .upload-choice{position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:32px;min-height:172px;padding:26px 28px;text-align:left;border:1px solid var(--glass-edge);border-radius:32px;background:linear-gradient(145deg,var(--tint-rose),transparent 44%),var(--glass);-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);color:var(--ink);box-shadow:var(--glass-shadow);cursor:pointer;animation:kc-fly 1s var(--ease) .06s backwards;transition:transform .5s var(--ease),box-shadow .5s var(--ease),border-color .2s}
  .upload-choice+.upload-choice{background:linear-gradient(145deg,var(--tint-violet),transparent 44%),var(--glass);animation-delay:.14s}
  .upload-choice::after{content:'';position:absolute;left:28px;right:28px;bottom:0;height:2px;border-radius:3px;background:linear-gradient(90deg,var(--rose),var(--plum));transform:scaleX(.18);transform-origin:left;transition:transform .5s var(--ease)}
  .upload-choice svg{width:44px;height:44px;padding:11px;border-radius:999px;background:#fff;color:var(--plum);box-shadow:0 8px 18px -10px rgba(123,47,143,.5)}.upload-choice span{font-size:20px;font-weight:800}
  .upload-choice:hover,.upload-choice:active{transform:translateY(-3px);box-shadow:0 30px 90px rgba(200,48,107,.17),inset 0 1px rgba(255,255,255,.6)}.upload-choice:hover::after,.upload-choice:active::after,.upload-choice[aria-expanded="true"]::after{transform:scaleX(1)}
  .upload-choice[aria-expanded="true"]{border-color:rgba(144,0,128,.32);background:linear-gradient(145deg,var(--tint-kcis),transparent 50%),rgba(255,255,255,.62)}.upload-choice[aria-expanded="true"] svg{color:var(--kcis)}
  .upload-choice:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
  .upload-panel{margin-top:24px;animation:kc-rise .7s var(--ease) backwards}.upload-help{padding:26px 28px;border:1px solid var(--glass-edge);border-radius:32px;background:linear-gradient(145deg,var(--tint-pink),transparent 44%),var(--glass);-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);box-shadow:var(--glass-shadow)}
  .upload-intro,.upload-guide{color:var(--ink-2);font-size:15px;line-height:1.8}.upload-guide{margin-top:22px}.upload-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:16px}
  .upload-link-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:46px;padding:11px 22px;border:1px solid transparent;border-radius:999px;font-size:14px;font-weight:800;text-decoration:none;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}.upload-link-button svg{width:19px;height:19px}
  .upload-kuse{background:var(--pink);color:var(--pink-ink);border-color:rgba(255,255,255,.55);box-shadow:var(--pink-shadow)}.upload-link-button:hover{transform:translateY(-1px);box-shadow:var(--pink-shadow-hover)}.upload-link-button:active{transform:translateY(1px);box-shadow:var(--pink-shadow-press)}.upload-link-button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}

  .upload-prompt{margin-top:24px;border-top:1px solid var(--line);padding-top:22px}.upload-prompt-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px}.upload-prompt-heading h2{font-family:'DM Mono',Nunito,'Noto Sans TC',monospace;font-size:12px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--plum)}
  .upload-copy{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 16px;border:1px solid var(--glass-edge);border-radius:999px;background:rgba(255,255,255,.66);color:var(--ink);font-size:13px;font-weight:800;cursor:pointer;box-shadow:var(--glass-shadow-sm);transition:background-color .2s,transform .3s var(--ease)}.upload-copy svg{color:var(--plum)}.upload-copy:hover{background:rgba(255,255,255,.92);transform:translateY(-1px)}.upload-copy:active{transform:translateY(1px);box-shadow:inset 0 2px 4px rgba(46,15,56,.1)}.upload-copy:disabled{cursor:wait;opacity:.7}.upload-copy:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
  #upload-prompt-text{display:block;width:100%;resize:vertical;min-height:180px;max-height:480px;border:1px solid var(--field-line);border-radius:16px;padding:16px;background:rgba(255,255,255,.7);color:var(--ink);font-family:inherit;font-size:14px;font-weight:600;line-height:1.75;white-space:pre-wrap}#upload-prompt-text:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
  .upload-copy-status{font-size:13px;color:var(--ink-2)}.upload-copy-status:empty{display:none}.upload-copy-status:not(:empty){margin-top:10px}
  .upload-keywords{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:26px 0}.upload-keywords label{flex-basis:100%;font-family:'DM Mono',Nunito,'Noto Sans TC',monospace;font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--plum)}.upload-keywords input{flex:1;min-width:200px;min-height:46px;background:rgba(255,255,255,.7);border:1px solid var(--field-line);border-radius:16px;padding:11px 16px;font-size:14px;font-weight:600;color:var(--ink)}.upload-keywords input::placeholder{color:var(--ink-3)}.upload-keywords input:focus{outline:2px solid var(--focus);outline-offset:2px}
  .upload-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}#upload-status{margin-top:18px;color:var(--ink-2);font-size:14px;overflow-wrap:anywhere}#upload-queue{display:grid;gap:8px}#upload-author{padding:7px 14px}
  /* Selected files (rows are built in document-upload.js) */
  #upload-queue>:global(li){flex-wrap:wrap;border-color:rgba(255,255,255,.9)!important;border-radius:16px!important;background:rgba(255,255,255,.62)!important;box-shadow:var(--glass-shadow-sm);animation:kc-rise .5s var(--ease) backwards}
  #upload-queue>:global(li>strong){flex:1 1 180px;color:var(--ink)}#upload-queue>:global(li>span){color:var(--ink-3)!important;font-weight:700}#upload-queue>:global(li>a){min-height:40px;padding:8px 16px}
  .document-upload [hidden]{display:none!important}
  @media(max-width:640px){.upload-choices{gap:12px}.upload-choice{min-height:152px;padding:20px;gap:24px;border-radius:24px}.upload-choice span{font-size:17px}.upload-choice::after{left:20px;right:20px}.upload-heading{align-items:flex-start;flex-wrap:wrap}.upload-dropzone{min-height:205px;padding:20px}.upload-keywords input{width:100%;min-width:0;flex-basis:100%}.upload-help{padding:22px 18px;border-radius:24px}}
  @media(max-width:360px){.upload-choices{grid-template-columns:1fr}.upload-choice{min-height:120px}}
  @media(prefers-reduced-motion:reduce){.upload-dropzone,.upload-choice,.upload-choice::after,.upload-link-button,.upload-copy{transition:none}.upload-choice:hover,.upload-choice:active,.upload-link-button:hover,.upload-link-button:active{transform:none}}
</style>

<style>.upload-steps{list-style:decimal;padding-left:1.4em}.upload-steps li{padding-left:4px;margin:8px 0}.upload-steps li::marker{color:var(--kcis);font-family:Comfortaa,Nunito,sans-serif;font-weight:700}</style>
