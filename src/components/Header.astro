---
import sites from '../../config/sites.json';
import SchoolAccount from './SchoolAccount.astro';
const base = import.meta.env.BASE_URL;
const isAi = Astro.url.pathname.replace(/\/$/, '').endsWith('/codex');
---
<header class="school-header">
  <div class="school-nav-shell">
    <a href={base} class="school-brand" data-i18n-aria="nav.homeTitle" aria-label="Back to main">
      <img src={`${base}brand/kangchiao-logo.png`} alt="KCIS" width="154" height="28" />
    </a>
    <nav aria-label="Primary" class="school-nav">
      <a href={`${base}search`} class:list={['nav-control', 'nav-wiki', !isAi && 'nav-active']}>WikiNB</a>
      <a href={`${base}codex`} class:list={['nav-control', 'nav-ai', isAi && 'nav-active']} data-i18n="nav.gemini">KCIS AI</a>
      <div id="nav-user-wrap" class="nav-popover hidden">
        <button id="nav-user" type="button" class="nav-control nav-account" aria-haspopup="menu" aria-expanded="false" aria-controls="nav-user-menu"></button>
        <div id="nav-user-menu" class="nav-panel hidden" role="menu">
          <a id="nav-edit-nick" href={`${base}nickname`} class="nav-item" role="menuitem" data-i18n="login.editNickname">Edit display name</a>
          <button id="nav-logout" type="button" class="nav-item" role="menuitem" data-i18n="login.logout">Log out</button>
        </div>
      </div>
      <a id="nav-login" href={`${base}login`} class="nav-control" data-i18n="nav.login">Log in</a>
      <div id="nav-mobile-wrap" class="nav-popover">
        <button id="nav-mobile-toggle" type="button" class="nav-control nav-menu-toggle" aria-expanded="false" aria-controls="nav-mobile-menu" data-i18n-aria="nav.menu" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div id="nav-mobile-menu" class="nav-panel hidden">
          <a href={`${base}search`} class="nav-item">WikiNB</a>
          <a href={`${base}library/`} class="nav-item" data-i18n="library.title">School Library</a>
          <a href={`${base}teachers`} class="nav-item" data-i18n="home.teachers">Teachers</a>
          <a id="nav-add-note" href={`${base}notes`} class="nav-item hidden" data-i18n="upload.title">Upload documents</a>
          <a id="nav-role-cta" href={`${base}my-notes`} class="nav-item" hidden aria-hidden="true" tabindex="-1" data-teacher-href={`${base}my-notes`} data-student-href={`${base}codex`} data-classroom-href={`${base}student`}><span class="nav-addnote-label" data-i18n="home.myNotes">My documents</span></a>
          <a href={sites.sites.navigator.url} class="nav-item" data-i18n="nav.ai">AI App Navigator</a>
        </div>
      </div>
    </nav>
  </div>
</header>
<SchoolAccount />
<script>
  import { mountI18n } from '../scripts/i18n.js';
  import { mountNavAuth } from '../scripts/auth-client.js';
  mountI18n();
  mountNavAuth();
  document.addEventListener('wikinb:auth-change', (event) => {
    document.getElementById('nav-add-note')?.classList.toggle('hidden', !event.detail?.isTeacher);
  });
</script>
<style>
  .school-header{position:fixed;inset:0 0 auto;z-index:50;background:rgba(248,249,253,.92);border-bottom:1px solid var(--kc-line);backdrop-filter:blur(20px)}
  .school-nav-shell{max-width:1152px;min-height:72px;margin:auto;padding:12px 32px;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .school-brand{display:flex;align-items:center;border-radius:8px;flex-shrink:0;transition:opacity .18s,transform .18s}.school-brand img{width:142px;height:auto}.school-brand:hover{opacity:.8}.school-brand:active{transform:translateY(1px)}
  .school-nav{display:flex;align-items:center;gap:6px}.nav-control{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:8px 14px;border:1px solid transparent;border-radius:999px;font-size:14px;font-weight:700;white-space:nowrap;color:var(--kc-blue-deep);background:transparent;cursor:pointer;transition:background .18s,border-color .18s,transform .18s,box-shadow .18s}
  .nav-control:hover{background:#fff;border-color:var(--kc-line);box-shadow:0 3px 9px #1b4f9c08}.nav-control:active{background:#e9eaf6;transform:translateY(2px)}.nav-control:focus-visible,.nav-item:focus-visible,.school-brand:focus-visible{outline:3px solid #8872bd;outline-offset:3px}
  .nav-active{border-color:var(--kc-line);background:#fff;box-shadow:0 3px 0 #1b4f9c09}.nav-ai{color:var(--kc-purple-deep)}.nav-account{max-width:140px;overflow:hidden;text-overflow:ellipsis;display:block;background:#edf0f9}
  .nav-popover{position:relative}.nav-panel{position:absolute;right:0;top:calc(100% + 10px);width:220px;padding:6px;border:1px solid var(--kc-line);border-radius:16px;background:#fff;box-shadow:0 16px 50px #1b4f9c1c}
  .nav-item{display:block;width:100%;padding:12px;border-radius:10px;text-align:left;font-size:14px;font-weight:600;color:var(--kc-blue-deep);cursor:pointer;transition:background .16s}.nav-item:hover,.nav-item:active{background:#eef0f9}.nav-menu-toggle{width:42px;padding:0}.hidden,[hidden]{display:none!important}
  @media(max-width:640px){.school-nav-shell{min-height:64px;padding:10px 14px;gap:8px}.school-brand img{width:92px}.school-nav{gap:2px}.nav-control{font-size:12px;padding:8px 9px;min-height:42px}.nav-wiki{display:none}.nav-account{max-width:66px}.nav-menu-toggle{width:36px}.nav-panel{max-width:calc(100vw - 28px)}}
  @media(max-width:359px){.school-brand img{width:74px}.nav-control{padding:8px 6px}.nav-account{max-width:48px}}
  @media(prefers-reduced-motion:reduce){.nav-control,.nav-item,.school-brand{transition:none}}
</style>
