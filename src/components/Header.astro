---
import sites from '../../config/sites.json';
import SchoolAccount from './SchoolAccount.astro';
const base = import.meta.env.BASE_URL;
const isAi = Astro.url.pathname.replace(/\/$/, '').endsWith('/codex');
---
<header class="school-header">
  <div class="school-nav-shell">
    <a href={base} class="school-brand" data-i18n-aria="nav.homeTitle" aria-label="Back to main">
      <img src={`${base}brand/kangchiao-logo.png`} alt="KCIS" width="154" height="28" />
    </a>
    <nav aria-label="Primary" class="school-nav">
      <a href={`${base}codex`} class:list={['nav-control', 'nav-ai', isAi && 'nav-active']} data-i18n="nav.gemini">KCIS AI</a>
      <div id="nav-mobile-wrap" class="nav-popover">
        <button id="nav-mobile-toggle" type="button" class="nav-control nav-menu-toggle" aria-expanded="false" aria-controls="nav-mobile-menu" data-i18n-aria="nav.menu" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div id="nav-mobile-menu" class="nav-panel hidden">
          <a href={sites.sites.navigator.url} class="nav-item nav-tools"><svg class="nav-tools-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg><span>AI Tools</span></a>
          <a href={`${base}search`} class="nav-item">WikiNB</a>
          <a id="nav-add-note" href={`${base}notes`} class="nav-item hidden" data-i18n="upload.title">Upload documents</a>
          <a id="nav-role-cta" href={`${base}my-notes`} class="nav-item" hidden aria-hidden="true" tabindex="-1" data-teacher-href={`${base}my-notes`} data-student-href={`${base}codex`} data-classroom-href={`${base}student`}><span class="nav-addnote-label" data-i18n="home.myNotes">My documents</span></a>
          <div class="nav-divider"></div>
          <div id="nav-user-wrap" class="hidden">
            <button id="nav-user" type="button" class="nav-item nav-profile" aria-haspopup="dialog" data-i18n-title="account.title" title="Account"><span id="nav-account-name"></span><span id="nav-account-department" class="nav-department"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
            <button id="nav-logout" type="button" class="nav-item" data-i18n="account.signout">Sign out</button>
          </div>
          <button id="nav-login" type="button" class="nav-item" data-i18n="account.checking" disabled>Checking…</button>
          <div class="nav-divider"></div>
          <button id="nav-language" type="button" class="nav-item nav-language" data-menu-persistent data-i18n-aria="nav.langTitle" aria-label="Switch to Chinese"><span data-i18n="nav.language">Language</span><span class="nav-language-options" aria-hidden="true"><span data-ui-language="en" lang="en">EN</span><span data-ui-language="zh-TW" lang="zh-TW">中文</span></span></button>
        </div>
      </div>
    </nav>
  </div>
</header>
<SchoolAccount />
<script>
  import { mountI18n, toggleLocale } from '../scripts/i18n.js';
  import { mountNavAuth } from '../scripts/auth-client.js';
  mountI18n();
  mountNavAuth();
  document.getElementById('nav-language')?.addEventListener('click', toggleLocale);
  document.addEventListener('wikinb:auth-change', (event) => {
    document.getElementById('nav-add-note')?.classList.toggle('hidden', !event.detail?.isTeacher);
  });
</script>
<style>
  .school-header{position:fixed;inset:0 0 auto;z-index:50;background:rgba(248,249,253,.92);border-bottom:1px solid var(--kc-line);backdrop-filter:blur(20px)}
  .school-nav-shell{width:100%;min-height:80px;padding:16px clamp(32px,3.34vw,64px);display:flex;align-items:center;justify-content:space-between;gap:16px}
  .school-brand{display:flex;align-items:center;border-radius:8px;flex-shrink:0;transition:opacity .18s,transform .18s}.school-brand img{width:176px;height:auto}.school-brand:hover{opacity:.8}.school-brand:active{transform:translateY(1px)}
  .school-nav{display:flex;align-items:center;gap:10px}.nav-control{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:10px 18px;border:1px solid transparent;border-radius:999px;font-size:15px;font-weight:700;white-space:nowrap;color:var(--kc-blue-deep);background:transparent;cursor:pointer;transition:background .18s,border-color .18s,transform .18s,box-shadow .18s}
  .nav-control:hover{background:#fff;border-color:var(--kc-line);box-shadow:0 3px 9px #1b4f9c08}.nav-control:active{background:#e9eaf6;transform:translateY(2px)}.nav-control:focus-visible,.nav-item:focus-visible,.school-brand:focus-visible{outline:3px solid #8872bd;outline-offset:3px}
  .nav-active{border-color:var(--kc-line);background:#fff;box-shadow:0 3px 0 #1b4f9c09}.nav-ai{color:var(--kc-purple-deep)}.nav-account{max-width:140px;overflow:hidden;text-overflow:ellipsis;display:block;background:#edf0f9}
  .nav-item.nav-tools{position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:center;gap:12px;min-height:48px;padding:12px 14px;border:1px solid #edf0f6;background:#fff;color:#354f81;font-weight:650;letter-spacing:.05px;transition:transform .22s ease,box-shadow .22s ease}
  .nav-tools-icon{width:20px;height:20px;flex:none;padding:1px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .nav-item.nav-tools::before{content:"";position:absolute;inset:0;z-index:-1;background:#f6f7fc;opacity:0;transition:opacity .25s ease}
  .nav-item.nav-tools::after{content:"";position:absolute;left:14px;right:14px;bottom:5px;height:2px;border-radius:3px;background:linear-gradient(90deg,#426dad,#8e6aae);transform:scaleX(.28);transform-origin:left;transition:transform .25s ease}
  .nav-item.nav-tools:hover,.nav-item.nav-tools:active{background:#fff}.nav-item.nav-tools:hover::before{opacity:1}.nav-item.nav-tools:hover::after,.nav-item.nav-tools:focus-visible::after{transform:scaleX(1)}.nav-item.nav-tools:active{transform:translateY(1px)}
  @media(prefers-reduced-motion:reduce){.nav-item.nav-tools,.nav-item.nav-tools::before,.nav-item.nav-tools::after{transition:none}}
  .nav-popover{position:relative}.nav-panel{position:absolute;right:0;top:calc(100% + 10px);width:244px;max-height:calc(100dvh - 108px);overflow-y:auto;padding:8px;border:1px solid var(--kc-line);border-radius:16px;background:#fff;box-shadow:0 16px 50px #1b4f9c1c}
  .nav-divider{height:1px;background:var(--kc-line);margin:6px 8px}.nav-profile{display:grid!important;grid-template-columns:minmax(0,1fr) 16px;gap:3px 12px}.nav-profile #nav-account-name{overflow:hidden;text-overflow:ellipsis}.nav-department{grid-column:1;font-size:12px;font-weight:400;color:var(--kc-muted);overflow-wrap:anywhere}.nav-profile svg{grid-column:2;grid-row:1/3;align-self:center;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6}.nav-language{display:flex!important;align-items:center;justify-content:space-between;gap:12px}.nav-language-options{display:flex;gap:2px;padding:3px;border:1px solid var(--kc-line);border-radius:999px;font-size:12px;font-weight:500;background:#f7f8fc}.nav-language-options span{padding:4px 9px;border-radius:999px;color:var(--kc-muted)}:global(html[data-locale="en"]) [data-ui-language="en"],:global(html[data-locale="zh-TW"]) [data-ui-language="zh-TW"]{background:#e5e2f4;color:var(--kc-purple-deep);font-weight:700}
  .nav-item{display:block;width:100%;padding:12px;border-radius:10px;text-align:left;font-size:14px;font-weight:600;color:var(--kc-blue-deep);cursor:pointer;transition:background .16s}.nav-item:hover,.nav-item:active{background:#eef0f9}.nav-menu-toggle{width:46px;padding:0}.hidden,[hidden]{display:none!important}
  @media(max-width:1023px){.school-nav-shell{min-height:72px;padding:14px 24px}.school-brand img{width:156px}.school-nav{gap:8px}.nav-control{min-height:44px;padding:9px 14px;font-size:14px}.nav-menu-toggle{width:44px;padding:0}.nav-panel{max-height:calc(100dvh - 100px)}}
  @media(max-width:640px){.school-nav-shell{min-height:64px;padding:10px 16px;gap:12px}.school-brand img{width:132px}.school-nav{gap:4px;min-width:0}.nav-control{font-size:13px;padding:9px 12px;min-height:44px}.nav-menu-toggle{width:44px;padding:0}.nav-panel{max-width:calc(100vw - 32px);max-height:calc(100dvh - 92px)}}
  @media(max-width:359px){.school-nav-shell{padding-inline:12px;gap:8px}.school-brand img{width:120px}.nav-control{padding-inline:10px}.nav-menu-toggle{padding:0}.nav-panel{max-width:calc(100vw - 24px)}}
  @media(prefers-reduced-motion:reduce){.nav-control,.nav-item,.school-brand{transition:none}}
</style>
