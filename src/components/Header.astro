---
import sites from '../../config/sites.json';
import SchoolAccount from './SchoolAccount.astro';
const base = import.meta.env.BASE_URL;
const isAi = Astro.url.pathname.replace(/\/$/, '').endsWith('/codex');
---
<header class="school-header">
  <div class="school-nav-shell">
    <a href={base} class="school-brand" data-i18n-aria="nav.homeTitle" aria-label="Back to main">
      <img src={`${base}brand/kangchiao-logo.png`} alt="KCIS" width="154" height="28" />
    </a>
    <nav aria-label="Primary" class="school-nav">
      <a href={`${base}codex`} class:list={['nav-control', 'nav-ai', isAi && 'nav-active']} data-i18n="nav.gemini">KCIS AI</a>
      <div id="nav-mobile-wrap" class="nav-popover">
        <button id="nav-mobile-toggle" type="button" class="nav-control nav-menu-toggle" aria-expanded="false" aria-controls="nav-mobile-menu" data-i18n-aria="nav.menu" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div id="nav-mobile-menu" class="nav-panel hidden">
          <a href={sites.sites.navigator.url} class="nav-item nav-tools"><svg class="nav-tools-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg><span>AI Tools</span></a>
          <a href={`${base}search`} class="nav-item">WikiNB</a>
          <a id="nav-add-note" href={`${base}notes`} class="nav-item hidden" data-i18n="upload.title">Upload documents</a>
          <a id="nav-role-cta" href={`${base}my-notes`} class="nav-item" hidden aria-hidden="true" tabindex="-1" data-teacher-href={`${base}my-notes`} data-student-href={`${base}codex`} data-classroom-href={`${base}student`}><span class="nav-addnote-label" data-i18n="home.myNotes">My documents</span></a>
          <div class="nav-divider"></div>
          <div id="nav-user-wrap" class="hidden">
            <button id="nav-user" type="button" class="nav-item nav-profile" aria-haspopup="dialog" data-i18n-title="account.title" title="Account"><span id="nav-account-name"></span><span id="nav-account-department" class="nav-department"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
            <button id="nav-logout" type="button" class="nav-item" data-i18n="account.signout">Sign out</button>
          </div>
          <button id="nav-login" type="button" class="nav-item" data-i18n="account.checking" disabled>Checking…</button>
          <div class="nav-divider"></div>
          <button id="nav-language" type="button" class="nav-item nav-language" data-menu-persistent data-i18n-aria="nav.langTitle" aria-label="Switch to Chinese"><span data-i18n="nav.language">Language</span><span class="nav-language-options" aria-hidden="true"><span data-ui-language="en" lang="en">EN</span><span data-ui-language="zh-TW" lang="zh-TW">中文</span></span></button>
        </div>
      </div>
    </nav>
  </div>
</header>
<SchoolAccount />
<script>
  import { mountI18n, toggleLocale } from '../scripts/i18n.js';
  import { mountNavAuth } from '../scripts/auth-client.js';
  mountI18n();
  mountNavAuth();
  document.getElementById('nav-language')?.addEventListener('click', toggleLocale);
  document.addEventListener('wikinb:auth-change', (event) => {
    document.getElementById('nav-add-note')?.classList.toggle('hidden', !event.detail?.isTeacher);
  });
</script>
<style>
  /* Shared KCIS school header: white 50% glass, blur 25px (same as ai-tools.kcis.kainnne.com). */
  .school-header{position:fixed;inset:0 0 auto;z-index:50;background:rgba(255,255,255,.5);-webkit-backdrop-filter:blur(25px) saturate(1.25);backdrop-filter:blur(25px) saturate(1.25);border-bottom:1px solid rgba(255,255,255,.7)}
  .school-nav-shell{width:100%;min-height:80px;padding:16px clamp(32px,3.34vw,64px);display:flex;align-items:center;justify-content:space-between;gap:16px}
  .school-brand{display:flex;align-items:center;border-radius:8px;flex-shrink:0;transition:opacity .2s,transform .3s var(--ease)}.school-brand img{width:176px;height:auto}.school-brand:hover{opacity:.82}.school-brand:active{transform:translateY(1px)}
  .school-nav{display:flex;align-items:center;gap:10px}.nav-control{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:10px 18px;border:1px solid transparent;border-radius:999px;font-size:15px;font-weight:800;white-space:nowrap;color:var(--ink);background:transparent;cursor:pointer;transition:background-color .2s,border-color .2s,transform .3s var(--ease),box-shadow .3s var(--ease)}
  .nav-control:hover{background:rgba(255,255,255,.62);border-color:rgba(255,255,255,.85);box-shadow:0 8px 20px -14px rgba(200,48,107,.45)}.nav-control:active{background:rgba(255,255,255,.85);transform:translateY(1px);box-shadow:inset 0 2px 4px rgba(46,15,56,.1)}.nav-control:focus-visible,.nav-item:focus-visible,.school-brand:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
  .nav-control[aria-expanded="true"]{background:rgba(255,255,255,.78);border-color:rgba(255,255,255,.9)}
  .nav-active{color:var(--kcis);border-color:rgba(255,255,255,.85);background:rgba(255,255,255,.62);box-shadow:0 8px 20px -14px rgba(144,0,128,.45)}.nav-account{max-width:140px;overflow:hidden;text-overflow:ellipsis;display:block;background:rgba(255,255,255,.6)}
  .nav-item.nav-tools{position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:center;gap:12px;min-height:56px;margin:2px 0 8px;padding:16px 14px;border:1px solid rgba(255,255,255,.9);border-radius:16px;background:linear-gradient(145deg,var(--tint-rose),transparent 60%),rgba(255,255,255,.7);color:var(--ink);font-weight:800;transition:transform .3s var(--ease),background-color .2s}
  .nav-tools-icon{width:20px;height:20px;flex:none;padding:1px;fill:none;stroke:var(--plum);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .nav-item.nav-tools::after{content:"";position:absolute;left:14px;right:14px;bottom:8px;height:2px;border-radius:3px;background:linear-gradient(90deg,var(--rose),var(--plum));transform:scaleX(.22);transform-origin:left;transition:transform .45s var(--ease)}
  .nav-item.nav-tools:hover,.nav-item.nav-tools:active{background-color:rgba(255,255,255,.95)}.nav-item.nav-tools:hover::after,.nav-item.nav-tools:active::after,.nav-item.nav-tools:focus-visible::after{transform:scaleX(1)}.nav-item.nav-tools:active{transform:translateY(1px)}
  @media(prefers-reduced-motion:reduce){.nav-item.nav-tools,.nav-item.nav-tools::after{transition:none}}
  .nav-popover{position:relative}.nav-panel{position:absolute;right:0;top:calc(100% + 10px);width:252px;max-height:calc(100dvh - 108px);overflow-y:auto;padding:8px;border:1px solid rgba(255,255,255,.9);border-radius:24px;background:linear-gradient(145deg,var(--tint-pink),transparent 44%),#fffafc;box-shadow:0 26px 80px rgba(200,48,107,.16),inset 0 1px rgba(255,255,255,.7);animation:nav-panel-in .45s var(--ease)}
  @keyframes nav-panel-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
  .nav-divider{height:1px;background:var(--line);margin:6px 10px}.nav-profile{display:grid!important;grid-template-columns:minmax(0,1fr) 16px;gap:3px 12px}.nav-profile #nav-account-name{overflow:hidden;text-overflow:ellipsis}.nav-department{grid-column:1;font-family:'DM Mono',Nunito,'Noto Sans TC',monospace;font-size:11px;font-weight:500;letter-spacing:.06em;color:var(--ink-3);overflow-wrap:anywhere}.nav-profile svg{grid-column:2;grid-row:1/3;align-self:center;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6}
  /* Language switch: glass track with a white thumb that slides. */
  .nav-language{display:flex!important;align-items:center;justify-content:space-between;gap:12px}
  .nav-language-options{position:relative;display:grid;grid-template-columns:1fr 1fr;padding:3px;border:1px solid rgba(255,255,255,.9);border-radius:999px;background:rgba(46,15,56,.06);font-size:12px;font-weight:700}
  .nav-language-options::before{content:"";position:absolute;top:3px;bottom:3px;left:3px;width:calc(50% - 3px);border-radius:999px;background:#fff;box-shadow:0 2px 8px -2px rgba(46,15,56,.2);transition:transform .45s var(--ease)}
  :global(html[data-locale="zh-TW"]) .nav-language-options::before{transform:translateX(100%)}
  .nav-language-options span{position:relative;z-index:1;min-width:42px;padding:4px 8px;border-radius:999px;text-align:center;color:var(--ink-3);transition:color .2s}
  :global(html[data-locale="en"]) [data-ui-language="en"],:global(html[data-locale="zh-TW"]) [data-ui-language="zh-TW"]{color:var(--kcis);font-weight:800}
  .nav-item{display:block;width:100%;padding:12px 14px;border-radius:16px;text-align:left;font-size:14px;font-weight:700;color:var(--ink);cursor:pointer;transition:background-color .2s}.nav-item:hover,.nav-item:active{background:rgba(255,128,178,.12)}.nav-item:disabled{color:var(--ink-3);cursor:default}.nav-menu-toggle{width:46px;padding:0}.hidden,[hidden]{display:none!important}
  @media(max-width:1023px){.school-nav-shell{min-height:72px;padding:14px 24px}.school-brand img{width:156px}.school-nav{gap:8px}.nav-control{min-height:44px;padding:9px 14px;font-size:14px}.nav-menu-toggle{width:44px;padding:0}.nav-panel{max-height:calc(100dvh - 100px)}}
  @media(max-width:640px){.school-nav-shell{min-height:64px;padding:10px 16px;gap:12px}.school-brand img{width:132px}.school-nav{gap:4px;min-width:0}.nav-control{font-size:13px;padding:9px 12px;min-height:44px}.nav-menu-toggle{width:44px;padding:0}.nav-panel{max-width:calc(100vw - 32px);max-height:calc(100dvh - 92px)}}
  @media(max-width:359px){.school-nav-shell{padding-inline:12px;gap:8px}.school-brand img{width:120px}.nav-control{padding-inline:10px}.nav-menu-toggle{padding:0}.nav-panel{max-width:calc(100vw - 24px)}}
  /* Phone landscape: a slimmer bar leaves room for the page. */
  @media(max-height:520px) and (orientation:landscape){.school-nav-shell{min-height:56px;padding:6px max(20px,env(safe-area-inset-right)) 6px max(20px,env(safe-area-inset-left))}.school-brand img{width:132px}.nav-control{min-height:42px}.nav-panel{max-height:calc(100dvh - 72px)}}
  @media(prefers-reduced-motion:reduce){.nav-control,.nav-item,.school-brand,.nav-language-options::before,.nav-language-options span{transition:none}.nav-panel{animation:none}}
</style>
