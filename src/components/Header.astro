---
const base=import.meta.env.BASE_URL;
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/40 bg-white/80 backdrop-blur-xl"><div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-4 md:px-8"><a href={base} aria-label="WikiNB KCIS"><img src={`${base}brand/kangchiao-logo.png`} alt="康橋" width="154" height="28" class="h-7 w-auto" /></a><nav class="flex items-center gap-3"><a id="portal-home" href="https://ai-tools.kcis.kainnne.com/" class="nav-secondary">AI Tools</a><a id="school-account" href="https://ai-tools.kcis.kainnne.com/?signin=1" class="nav-secondary" data-i18n="nav.login">登入</a><button id="btn-lang" class="nav-lang">English</button></nav></div></header>
<script>
import {mountI18n} from '../scripts/i18n.js';mountI18n();
if(import.meta.env.PUBLIC_PORTAL_URL)document.getElementById('portal-home').href=import.meta.env.PUBLIC_PORTAL_URL;
if(['localhost','127.0.0.1'].includes(location.hostname))document.getElementById('portal-home').href=`http://${location.hostname}:3000/`;
</script>
