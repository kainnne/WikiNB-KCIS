---
interface Props { mine?: boolean; }
const {mine=false}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<section id="school-library" class="school-library" data-mine={String(mine)}>
  <header class="library-heading"><h1 data-i18n={mine?'home.myNotes':'library.title'}>{mine?'My documents':'School Library'}</h1><a id="library-upload" href={`${base}notes`} class="kc-btn-primary" hidden data-i18n="upload.title">Upload documents</a></header>
  <p id="library-status" role="status" aria-live="polite"></p>
  <div id="library-gate" class="kc-card" hidden><p data-i18n="library.gate">Sign in with your school email to read documents.</p><a id="library-login" href={`${base}login`} class="kc-btn-primary" data-school-signin data-i18n="nav.login">Sign in</a></div>
  <div id="library-content" hidden>
    <div class="library-filters">
      {!mine&&<div class="library-roles" role="group" aria-label="Uploaded by"><button type="button" data-role="" aria-pressed="true" data-i18n="library.all">All</button><button type="button" data-role="teachers" aria-pressed="false" data-i18n="library.teachers">Teachers</button><button type="button" data-role="students" aria-pressed="false" data-i18n="library.students">Students</button><button type="button" data-role="forum" aria-pressed="false">AI Forum</button></div>}
      <input id="library-query" type="search" data-i18n-placeholder="search.placeholder" data-i18n-aria="search.placeholder" placeholder="Search documents or keywords" aria-label="Search documents or keywords" />
    </div>
    <div class:list={['library-columns',mine&&'library-mine']}>
      <div>
        <div id="library-files" class="library-files"></div>
        <article id="library-reader" class="kc-card" hidden>
          <button id="library-close" type="button" class="kc-btn-ghost" data-i18n="library.back">Back to list</button>
          <h2 id="library-reader-title"></h2><div id="library-reader-keywords" class="library-tags"></div>
          <div class="library-reader-actions"><button id="library-copy" type="button" class="wiki-fs-btn wiki-copy-btn" data-i18n-aria="reader.copy" aria-label="Copy link"><span class="wiki-copy-label">copy</span></button><button id="library-maximize" type="button" class="wiki-fs-btn" aria-label="Expand reader"><span class="wiki-fs-icon" aria-hidden="true">⛶</span></button><button id="library-markdown-download" class="kc-btn-ghost" type="button" hidden data-i18n="document.markdown">Download Markdown</button></div>
          <div id="library-markdown" class="wiki-content wiki-reader-body"></div>
        </article>
        {mine&&<section id="legacy-notes" hidden><h2 data-i18n="library.earlier">Earlier notes</h2><div id="legacy-notes-list" class="library-files"></div></section>}
      </div>
      {!mine&&<aside class="library-chat kc-card"><h2>KCIS AI</h2><form id="library-ask"><label for="library-question" data-i18n="library.question">Your question</label><textarea id="library-question" maxlength="4000" required></textarea><button class="kc-btn-primary" type="submit" data-i18n="library.send">Ask</button></form><div id="library-answer" class="wiki-content" aria-live="polite"></div><div id="library-sources"></div></aside>}
    </div>
  </div>
</section>
<script>
  import '../scripts/school-library.js';
</script>
<style is:global>
  .school-library{max-width:1100px;margin:10px auto;min-width:0}.library-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;animation:kc-rise .9s var(--ease) backwards}.library-heading h1{font-family:Comfortaa,Nunito,'Noto Sans TC',sans-serif;font-size:clamp(26px,4vw,34px);font-weight:700;letter-spacing:-.02em;color:var(--ink)}
  #library-status{font-size:14px;color:var(--ink-2);margin-bottom:18px;overflow-wrap:anywhere}#library-status:empty{display:none}#library-gate{padding:28px}#library-gate p{margin-bottom:18px;color:var(--ink-2)}
  .library-filters{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}
  .library-roles{display:flex;gap:2px;flex-wrap:wrap;padding:4px;border:1px solid var(--glass-edge);border-radius:999px;background:rgba(46,15,56,.05)}.library-roles button{min-height:40px;padding:8px 14px;border-radius:999px;font-size:14px;font-weight:700;color:var(--ink-2);transition:background-color .25s,color .2s,box-shadow .25s}.library-roles button:hover,.library-roles button:active{background:rgba(255,255,255,.6);color:var(--ink)}.library-roles button[aria-pressed=true]{background:#fff;color:var(--kcis);box-shadow:0 2px 8px -2px rgba(46,15,56,.2)}
  .library-filters input{min-width:0;width:320px;max-width:100%;min-height:46px;background:rgba(255,255,255,.7);border:1px solid var(--field-line);border-radius:16px;padding:11px 16px;font-size:14px;font-weight:600;color:var(--ink)}.library-filters input::placeholder{color:var(--ink-3)}
  .library-categories{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.library-categories button{border:1px solid var(--glass-edge);background:rgba(255,255,255,.6);border-radius:999px;padding:8px 14px;min-height:40px;font-size:13px;font-weight:700;color:var(--ink);transition:background-color .2s}.library-categories button[aria-pressed=true]{color:var(--kcis);background:#fff}.library-categories button:hover,.library-categories button:active{background:rgba(255,255,255,.9)}
  .library-columns{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px}.library-columns>div{min-width:0}.library-mine{grid-template-columns:1fr}
  .library-files{display:grid;gap:10px}.library-file{position:relative;display:block;width:100%;text-align:left;padding:18px 22px;border:1px solid var(--glass-edge);border-radius:24px;background:linear-gradient(145deg,var(--tint-pink),transparent 44%),rgba(255,255,255,.55);-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);box-shadow:var(--glass-shadow-sm);cursor:pointer;animation:kc-rise .6s var(--ease) backwards;transition:transform .45s var(--ease),background-color .2s}
  .library-file:nth-child(even){background:linear-gradient(145deg,var(--tint-violet),transparent 44%),rgba(255,255,255,.55)}
  .library-file:hover,.library-file:active{transform:translateY(-2px);background-color:rgba(255,255,255,.75)}.library-file strong{display:block;overflow-wrap:anywhere;font-size:16px;font-weight:800;color:var(--ink)}.library-file small{display:block;margin:8px 0;color:var(--ink-3);font-size:12px;font-weight:600}
  .library-files>p{padding:22px;border-radius:24px;background:rgba(255,255,255,.45);color:var(--ink-2);text-align:center}
  .library-tags{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.library-tags .tag-badge{font-size:12px}
  .library-chat{align-self:start;position:sticky;top:94px;padding:22px;background:linear-gradient(145deg,var(--tint-violet),transparent 44%),var(--glass)}.library-chat h2{font-family:Comfortaa,Nunito,'Noto Sans TC',sans-serif;font-size:20px;font-weight:700;color:var(--ink);margin-bottom:20px}.library-chat form{display:grid;gap:12px}.library-chat label{font-size:14px;color:var(--ink-2)}.library-chat textarea{width:100%;min-height:110px;border:1px solid var(--field-line);border-radius:16px;background:rgba(255,255,255,.7);padding:12px;resize:vertical;font-size:16px;font-weight:600;color:var(--ink)}
  #library-answer{margin-top:24px;font-size:14px;overflow-wrap:anywhere}#library-sources button{display:block;margin-top:12px;text-align:left;color:var(--plum);font-weight:700;text-decoration:underline;text-decoration-color:rgba(123,47,143,.35);text-underline-offset:3px}#library-sources button:hover{text-decoration-color:currentColor}
  #library-reader{padding:24px 28px;background:linear-gradient(145deg,var(--tint-pink),transparent 44%),var(--glass-strong)}#library-reader h2{font-family:Comfortaa,Nunito,'Noto Sans TC',sans-serif;font-size:24px;font-weight:700;color:var(--ink);margin:22px 0 10px;overflow-wrap:anywhere}.library-reader-actions{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}#library-markdown{margin-top:24px;overflow-wrap:anywhere}#library-markdown img{max-width:100%;height:auto}
  #legacy-notes{margin-top:32px}#legacy-notes h2{font-family:Comfortaa,Nunito,'Noto Sans TC',sans-serif;font-size:20px;font-weight:700;color:var(--ink);margin-bottom:16px}
  .school-library [hidden]{display:none!important}.school-library button:focus-visible,.school-library input:focus-visible,.school-library textarea:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
  @media(max-width:800px){.library-columns{grid-template-columns:1fr}.library-chat{position:static}.library-filters{flex-wrap:wrap}.library-filters input{width:100%}.library-heading{flex-wrap:wrap;align-items:flex-start}#library-reader{padding:18px;border-radius:24px}}
  @media(prefers-reduced-motion:reduce){.library-file,.library-roles button,.library-categories button{transition:none;transform:none!important}}
</style>
