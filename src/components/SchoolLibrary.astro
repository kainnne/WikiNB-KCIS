---
interface Props { mine?: boolean; }
const {mine=false}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<section id="school-library" class="school-library" data-mine={String(mine)}>
  <header class="library-heading"><h1 data-i18n={mine?'home.myNotes':'library.title'}>{mine?'My documents':'School Library'}</h1><a id="library-upload" href={`${base}notes`} class="kc-btn-primary" hidden data-i18n="upload.title">Upload documents</a></header>
  <p id="library-status" role="status" aria-live="polite"></p>
  <div id="library-gate" class="kc-card" hidden><p data-i18n="library.gate">Sign in with your school email to read documents.</p><a id="library-login" href={`${base}login`} class="kc-btn-primary" data-school-signin data-i18n="nav.login">Sign in</a></div>
  <div id="library-content" hidden>
    <div class="library-filters">
      {!mine&&<div class="library-roles" role="group" aria-label="Uploaded by"><button type="button" data-role="" aria-pressed="true" data-i18n="library.all">All</button><button type="button" data-role="teachers" aria-pressed="false" data-i18n="library.teachers">Teachers</button><button type="button" data-role="students" aria-pressed="false" data-i18n="library.students">Students</button><button type="button" data-role="forum" aria-pressed="false">AI Forum</button></div>}
      <input id="library-query" type="search" data-i18n-placeholder="search.placeholder" data-i18n-aria="search.placeholder" placeholder="Search documents or keywords" aria-label="Search documents or keywords" />
    </div>
    <div id="library-categories" class="library-categories" data-i18n-aria="library.categories" aria-label="Categories"></div>
    <div class:list={['library-columns',mine&&'library-mine']}>
      <div>
        <div id="library-files" class="library-files"></div>
        <article id="library-reader" class="kc-card" hidden>
          <button id="library-close" type="button" class="kc-btn-ghost" data-i18n="library.back">Back to list</button>
          <h2 id="library-reader-title"></h2><div id="library-reader-keywords" class="library-tags"></div>
          <div class="library-reader-actions"><button id="library-download" class="kc-btn-ghost" type="button" data-i18n="document.original">Download original</button><button id="library-markdown-download" class="kc-btn-ghost" type="button" hidden data-i18n="document.markdown">Download Markdown</button></div>
          <div id="library-markdown" class="wiki-content"></div>
        </article>
        {mine&&<section id="legacy-notes" hidden><h2 data-i18n="library.earlier">Earlier notes</h2><div id="legacy-notes-list" class="library-files"></div></section>}
      </div>
      {!mine&&<aside class="library-chat kc-card"><h2>KCIS AI</h2><form id="library-ask"><label for="library-question" data-i18n="library.question">Your question</label><textarea id="library-question" maxlength="4000" required></textarea><button class="kc-btn-primary" type="submit" data-i18n="library.send">Ask</button></form><div id="library-answer" class="wiki-content" aria-live="polite"></div><div id="library-sources"></div></aside>}
    </div>
  </div>
</section>
<script>
  import '../scripts/school-library.js';
</script>
<style is:global>
  .school-library{max-width:1100px;margin:10px auto;min-width:0}.library-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}.library-heading h1{font-size:clamp(26px,4vw,34px);font-weight:800;color:var(--kc-blue-deep)}#library-status{font-size:14px;color:var(--kc-muted);margin-bottom:18px;overflow-wrap:anywhere}#library-status:empty{display:none}#library-gate{padding:28px}#library-gate p{margin-bottom:18px}.library-filters{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.library-roles{display:flex;gap:4px;flex-wrap:wrap}.library-roles button{min-height:44px;padding:8px 12px;border-radius:999px;font-size:14px;color:var(--kc-muted);transition:background .18s}.library-roles button[aria-pressed=true],.library-roles button:hover,.library-roles button:active{background:#e9ecf8;color:var(--kc-blue-deep)}.library-filters input{min-width:0;width:320px;max-width:100%;background:#fff;border:1px solid var(--kc-line);border-radius:999px;padding:11px 16px;font-size:14px}.library-categories{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.library-categories button{border:1px solid var(--kc-line);background:#fff;border-radius:999px;padding:8px 12px;min-height:40px;font-size:13px;color:var(--kc-blue-deep);transition:background .18s,border-color .18s}.library-categories button[aria-pressed=true],.library-categories button:hover,.library-categories button:active{background:#edeaf7;border-color:#b6a8d4}.library-columns{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px}.library-columns>div{min-width:0}.library-mine{grid-template-columns:1fr}.library-files{display:grid;gap:10px}.library-file{display:block;width:100%;text-align:left;padding:18px;border:1px solid var(--kc-line);border-radius:16px;background:#fff;cursor:pointer;transition:border-color .18s,transform .18s}.library-file:hover,.library-file:active{border-color:#9da9d2;transform:translateY(-1px)}.library-file strong{display:block;overflow-wrap:anywhere;font-size:16px;color:var(--kc-blue-deep)}.library-file small{display:block;margin:8px 0;color:var(--kc-muted);font-size:12px}.library-tags{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.library-tags .tag-badge{font-size:12px}.library-chat{align-self:start;position:sticky;top:94px;padding:22px}.library-chat h2{font-size:20px;font-weight:800;color:var(--kc-purple-deep);margin-bottom:20px}.library-chat form{display:grid;gap:12px}.library-chat label{font-size:14px}.library-chat textarea{width:100%;min-height:110px;border:1px solid var(--kc-line);border-radius:14px;background:#fff;padding:12px;resize:vertical;font-size:16px}#library-answer{margin-top:24px;font-size:14px;overflow-wrap:anywhere}#library-sources button{display:block;margin-top:12px;text-align:left;color:var(--kc-blue);text-decoration:underline}#library-reader{padding:24px}#library-reader h2{font-size:24px;font-weight:800;margin:22px 0 10px;overflow-wrap:anywhere}.library-reader-actions{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}#library-markdown{margin-top:24px;overflow-wrap:anywhere}#library-markdown img{max-width:100%;height:auto}#legacy-notes{margin-top:32px}#legacy-notes h2{font-size:20px;font-weight:800;margin-bottom:16px}.school-library [hidden]{display:none!important}.school-library button:focus-visible,.school-library input:focus-visible,.school-library textarea:focus-visible{outline:3px solid var(--kc-purple-soft);outline-offset:3px}@media(max-width:800px){.library-columns{grid-template-columns:1fr}.library-chat{position:static}.library-filters{flex-wrap:wrap}.library-filters input{width:100%}.library-heading{flex-wrap:wrap;align-items:flex-start}#library-reader{padding:18px}}@media(prefers-reduced-motion:reduce){.library-file,.library-roles button,.library-categories button{transition:none;transform:none!important}}
</style>
