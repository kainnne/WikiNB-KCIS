---
interface Props {
  placeholder?: string;
  size?: 'sm' | 'lg';
  action?: string;
  showButton?: boolean;
  buttonLabel?: string;
}

const {
  size = 'sm',
  action = '/search',
  showButton = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const formAction = action.startsWith('http') ? action : `${base}${action.replace(/^\//, '')}`;
---

<form action={formAction} method="get" class="w-full">
  <div class="relative w-full">
    <span
      class="pointer-events-none absolute left-5 top-1/2 z-[1] -translate-y-1/2 text-kc-plum"
      aria-hidden="true"
    >
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
    </span>
    <input
      type="search"
      name="q"
      placeholder="Try: teacher name, subject, topic…"
      data-i18n-placeholder="search.placeholder"
      class:list={['search-input', size === 'lg' && 'py-4 text-lg']}
      autocomplete="off"
    />
  </div>
  {showButton && (
    <button
      type="submit"
      class="kc-btn-primary mt-4 w-full justify-center py-3 text-base md:text-lg"
      data-i18n="search.button"
    >Search</button>
  )}
</form>
