---
const base = import.meta.env.BASE_URL;
---
<form action={`${base}search`} method="get" class="home-search">
  <div class="home-search-field">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
    <input type="search" name="q" autocomplete="off" data-i18n-placeholder="home.placeholder" data-i18n-aria="home.search" placeholder="Search documents or keywords…" aria-label="Search" />
    <button type="submit" class="kc-btn-ghost" data-i18n="home.search">Search</button>
  </div>
</form>
<style>
  .home-search{width:100%}.home-search-field{display:flex;align-items:center;gap:10px;padding:6px 6px 6px 18px;background:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.9);border-radius:999px;-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);box-shadow:var(--glass-shadow);transition:background-color .2s}.home-search-field:focus-within{background:rgba(255,255,255,.86);outline:2px solid var(--focus);outline-offset:2px}.home-search-field svg{flex-shrink:0;color:var(--plum)}input{min-width:0;flex:1;min-height:44px;background:transparent;border:none;outline:none;font-size:14px;font-weight:600;color:var(--ink)}input:focus-visible{outline:none}input::placeholder{color:var(--ink-3)}.home-search-field button{padding:8px 20px;flex-shrink:0;min-height:44px;color:var(--pink-ink);background:var(--pink);border-color:rgba(255,255,255,.55);box-shadow:var(--pink-shadow);-webkit-backdrop-filter:none;backdrop-filter:none}.home-search-field button:hover{background:var(--pink);box-shadow:var(--pink-shadow-hover)}.home-search-field button:active{background:var(--pink);box-shadow:var(--pink-shadow-press)}@media(max-width:480px){.home-search-field{gap:6px;padding-left:14px}input{font-size:13px}.home-search-field button{padding:8px 14px}}@media(prefers-reduced-motion:reduce){.home-search-field{transition:none}}
</style>
