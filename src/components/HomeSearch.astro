---
const base = import.meta.env.BASE_URL;
---
<form action={`${base}search`} method="get" class="home-search">
  <div class="home-search-field">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
    <input type="search" name="q" autocomplete="off" data-i18n-placeholder="home.placeholder" data-i18n-aria="home.search" placeholder="Search documents or keywords…" aria-label="Search" />
    <button type="submit" class="kc-btn-ghost" data-i18n="home.search">Search</button>
  </div>
</form>
<style>
  .home-search{width:100%}.home-search-field{display:flex;align-items:center;gap:10px;padding:7px 8px 7px 16px;background:rgba(255,255,255,.85);border:1px solid var(--kc-line);border-radius:999px;box-shadow:0 5px 20px #1b4f9c05;transition:border-color .2s,box-shadow .2s}.home-search-field:focus-within{border-color:var(--kc-purple-soft);box-shadow:0 0 0 3px #6b3d9a0c}.home-search-field svg{flex-shrink:0;color:var(--kc-muted)}input{min-width:0;flex:1;background:transparent;border:none;outline:none;font-size:14px;color:var(--kc-ink)}input::placeholder{color:var(--kc-muted)}.home-search-field button{padding:8px 16px;flex-shrink:0;min-height:40px;box-shadow:none;background:#edf0f8;border-color:transparent}@media(max-width:480px){.home-search-field{gap:6px;padding-left:12px}input{font-size:13px}.home-search-field button{padding:8px 12px}}@media(prefers-reduced-motion:reduce){.home-search-field{transition:none}}
</style>
