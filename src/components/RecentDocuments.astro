---
const base=import.meta.env.BASE_URL;
---
<section id="home-documents" hidden>
  <div class="recent-documents-heading"><h2 data-i18n="home.recent">Recently updated</h2><a href={`${base}search`} data-i18n="library.allDocuments">All documents</a></div>
  <div id="home-documents-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
</section>
<script>
  import {fetchMe} from '../scripts/auth-client.js';
  import {readSchoolDocuments} from '../scripts/shared-documents.js';
  import {t,getLocale} from '../scripts/i18n.js';
  const section=document.getElementById('home-documents'),list=document.getElementById('home-documents-list');
  let generation=0,rows=[],categories=[];
  function render(){
    list.replaceChildren();
    for(const file of rows){
      const link=document.createElement('a');link.className='wiki-preview-card kc-card-hover flex h-full flex-col p-5 md:p-6';link.href=(document.documentElement.dataset.base||'/')+'note?'+new URLSearchParams({file:file.id});
      const tags=document.createElement('div');tags.className='mb-3 flex flex-wrap gap-2';
      for(const word of file.keywords||[]){const tag=document.createElement('span');tag.className='tag-badge';tag.textContent=word==='教職員'?t('account.staff'):word==='學生'?t('account.student'):word;tags.append(tag);}
      const title=document.createElement('h3');title.className='font-display text-lg font-bold text-kc-blue-deep';title.textContent=file.title||file.filename;
      const category=document.createElement('p');category.className='mt-2 text-sm text-kc-muted';const matched=categories.find(row=>row.id===file.category);category.textContent=(getLocale()==='en'?matched?.en:matched?.zh)||file.category;
      link.append(tags,title,category);list.append(link);
    }
    section.hidden=!rows.length;
  }
  async function load(){const current=++generation;try{const data=await readSchoolDocuments();if(current!==generation)return;categories=data.categories;rows=data.files.filter(file=>!file.deletedAt).sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0,6);render();}catch{if(current===generation){rows=[];render();}}}
  async function init(){const me=await fetchMe();if(me.authenticated)void load();}
  void init();
  document.addEventListener('wikinb:auth-change',event=>{if(event.detail?.loggedIn)void load();else{generation++;rows=[];render();}});
  document.addEventListener('wikinb:locale-change',render);
  window.addEventListener('kcis:account-updated',event=>event.detail?.waitUntil?.(load()));
</script>
<style>
  #home-documents{margin-top:12px}.recent-documents-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.recent-documents-heading h2{font-family:Nunito,'Noto Sans TC',sans-serif;font-size:24px;font-weight:700;color:var(--kc-blue-deep)}.recent-documents-heading>a{font-size:14px;color:var(--kc-blue);text-decoration:underline;text-underline-offset:4px;white-space:nowrap}.recent-documents-heading>a:focus-visible{outline:3px solid var(--kc-purple-soft);outline-offset:4px}
</style>
