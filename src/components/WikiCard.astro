---
/**
 * 筆記預覽字卡
 * 連結規則（同步、不打 API）：
 * - 無 token → login?next=/note?...
 * - 有 token → /note?...（真正權限由 note 頁伺服器驗證）
 */
interface Props {
  slug: string;
  title: string;
  description: string;
  teacher: string;
  subject: string;
  subjectEn?: string;
  date: string;
  teacherId?: string;
  subjectId?: string;
}

const { slug, title, description, teacher, subject, subjectEn, date, teacherId, subjectId } =
  Astro.props;
const base = import.meta.env.BASE_URL;
const subjectLabelEn = subjectEn || subject;

const parts = String(slug || '').split('/').filter(Boolean);
const tid = teacherId || (parts[0] === 'teachers' ? parts[1] : '');
const sid = subjectId || (parts[0] === 'teachers' ? parts[2] : '');
const noteSlug =
  parts[0] === 'teachers' && parts.length >= 4 ? parts.slice(3).join('/') : parts[parts.length - 1] || '';

const notePath = `${base}note?teacherId=${encodeURIComponent(tid)}&subjectId=${encodeURIComponent(sid)}&slug=${encodeURIComponent(noteSlug)}`;
const loginHref = `${base}login?next=${encodeURIComponent(notePath)}`;
---

<a
  href={loginHref}
  class="wiki-preview-card kc-card-hover flex h-full flex-col p-5 md:p-6"
  data-note-href={notePath}
  data-login-href={loginHref}
>
  <div class="mb-2 flex min-h-[1.25rem] items-center">
    <time class="text-xs font-semibold text-kc-purple">{date}</time>
  </div>

  <div class="mb-2 flex min-h-[1.5rem] flex-wrap gap-2">
    {teacher ? (
      <span class="tag-keyword">{teacher}</span>
    ) : (
      <span class="tag-badge invisible select-none" aria-hidden="true">占位</span>
    )}
    {subject ? (
      <span class="tag-keyword" data-locale-text data-zh={subject} data-en={subjectLabelEn}>
        {subject}
      </span>
    ) : (
      <span class="tag-badge invisible select-none" aria-hidden="true">占位</span>
    )}
  </div>

  <h3 class="line-clamp-1 font-display text-lg font-bold text-kc-blue-deep md:text-xl">{title}</h3>
  <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-kc-muted">{description}</p>
  <p class="wiki-card-hint mt-3 text-xs font-semibold text-kc-blue">登入後閱讀 →</p>
</a>

<script>
  import { hasSessionHint } from '../scripts/auth-client.js';

  function wirePreviewCards() {
    const hinted = hasSessionHint();
    document.querySelectorAll('a.wiki-preview-card').forEach((el) => {
      const note = el.getAttribute('data-note-href');
      const login = el.getAttribute('data-login-href');
      const hintEl = el.querySelector('.wiki-card-hint');
      if (hinted && note) {
        el.setAttribute('href', note);
        if (hintEl) hintEl.textContent = '開啟筆記 →';
      } else if (login) {
        el.setAttribute('href', login);
        if (hintEl) hintEl.textContent = '登入後閱讀 →';
      }
    });
  }

  wirePreviewCards();
  document.addEventListener('wikinb:auth-change', () => wirePreviewCards());
</script>
