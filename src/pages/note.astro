---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Note" description="登入後由 Auth 讀取筆記（不依賴靜態建置）">
  <div class="animate-fadeIn mx-auto max-w-3xl">
    <div id="note-loading" class="kc-card p-8 text-center text-kc-muted" data-i18n="note.checking">Checking sign-in…</div>
    <div id="note-gate" class="kc-card hidden p-8 text-center text-kc-muted">
      <p class="mb-3" data-i18n="note.gate">This note is available only to signed-in Kang Chiao users.</p>
      <a id="note-login-link" href={`${base}login`} class="kc-btn-primary inline-flex" data-i18n="note.goLogin">Go to login</a>
    </div>
    <div id="note-error" class="kc-card hidden border border-red-200 bg-red-50/80 p-6 text-red-800"></div>

    <article id="note-article" class="hidden">
      <header class="mb-8">
        <div id="note-tags" class="mb-3 flex flex-wrap items-center gap-2"></div>
        <h1 id="note-title" class="font-display text-3xl font-bold text-kc-blue-deep md:text-4xl"></h1>
        <p id="note-meta" class="mt-2 text-sm text-kc-muted"></p>
      </header>
      <section id="note-source" class="mb-5 hidden flex-wrap items-center justify-between gap-4 rounded-2xl border border-kc-blue/20 bg-kc-mist/60 p-4">
        <div class="min-w-0">
          <p class="text-sm font-bold text-kc-blue-deep" data-i18n="note.originalPdf">Original PDF material</p>
          <p id="note-source-meta" class="mt-1 truncate text-xs text-kc-muted"></p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button id="note-open-source" type="button" class="kc-btn-primary py-2 text-sm" data-i18n="note.openOriginalPdf">Open original PDF</button>
          <button id="note-download-source" type="button" class="kc-btn-secondary py-2 text-sm" data-i18n="note.downloadOriginal">Download original</button>
        </div>
      </section>
      <div id="note-body" class="kc-card kc-core-card wiki-content p-6 md:p-10"></div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}search`} class="kc-btn-ghost" data-i18n="wiki.library">← Library</a>
        <a href={`${base}my-notes`} class="kc-btn-ghost" data-i18n="home.myNotes">My documents</a>
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  import {
    clearSessionHint,
    downloadUploadedFile,
    hasSessionHint,
    isTeacherUser,
    openUploadedFile,
    readWikiFile,
    requireLogin,
  } from '../scripts/auth-client.js';
  import { loginHrefWithNext, markdownToHtml } from '../scripts/md-render.js';
  import { t } from '../scripts/i18n.js';

  function pageBase() {
    return document.documentElement.dataset.base || '/WikiNB-KCIS/';
  }

  const params = new URLSearchParams(window.location.search);
  const teacherId = params.get('teacherId') || '';
  const subjectId = params.get('subjectId') || '';
  const slug = params.get('slug') || '';

  const loading = document.getElementById('note-loading');
  const gate = document.getElementById('note-gate');
  const errEl = document.getElementById('note-error');
  const article = document.getElementById('note-article');
  const loginLink = document.getElementById('note-login-link');
  let currentSource = null;

  function renderSourceMeta() {
    const meta = document.getElementById('note-source-meta');
    if (!meta || !currentSource) return;
    meta.textContent = t('note.pdfSourceMeta', {
      name: currentSource.originalName || 'PDF',
      pages: currentSource.pageCount || '—',
    });
  }

  const next = `${window.location.pathname}${window.location.search}`;
  const loginUrl = loginHrefWithNext(next, pageBase());
  if (loginLink) loginLink.setAttribute('href', loginUrl);

  function showError(msg) {
    loading?.classList.add('hidden');
    gate?.classList.add('hidden');
    if (errEl) {
      errEl.textContent = msg || t('note.openFailed');
      errEl.classList.remove('hidden');
    }
  }

  function goLogin(reason) {
    loading?.classList.add('hidden');
    if (gate) {
      const p = gate.querySelector('p');
      if (p && reason) p.textContent = reason;
      gate.classList.remove('hidden');
    }
    // 無 token：立刻走；有失效 token：清掉再走
    if (!hasSessionHint()) {
      window.location.replace(loginUrl);
      return;
    }
    clearSessionHint();
    window.location.replace(loginUrl);
  }

  (async () => {
    if (!subjectId || !slug) {
      showError(t('note.missingSubject'));
      return;
    }
    if (!teacherId) {
      showError(t('note.missingTeacher'));
      return;
    }

    // github.io 必須靠 local token（跨站 cookie 不可用）→ 無提示立刻登入，不等待
    const onLocal =
      location.hostname === '127.0.0.1' || location.hostname === 'localhost';
    if (!hasSessionHint() && !onLocal) {
      goLogin(t('note.loginRequired'));
      return;
    }

    // 唯一可信檢查：Auth /api/auth/me（fail-closed）
    const session = await requireLogin({
      timeoutMs: hasSessionHint() ? 3500 : 2000,
    });
    if (!session.authenticated) {
      goLogin(
        session.offline
          ? t('note.authUnavailable')
          : t('note.loginRequired'),
      );
      return;
    }

    if (loading) loading.textContent = t('note.loading');

    try {
      const data = await readWikiFile({ subjectId, slug, teacherId });
      const title = data.title || slug;
      document.title = `${title} · WikiNB KCIS`;
      const titleEl = document.getElementById('note-title');
      const bodyEl = document.getElementById('note-body');
      const tagsEl = document.getElementById('note-tags');
      const metaEl = document.getElementById('note-meta');
      if (titleEl) titleEl.textContent = title;
      if (metaEl) {
        metaEl.textContent = `${data.storage || 'live'} · ${teacherId}/${subjectId}/${slug}.md`;
      }
      if (tagsEl) {
        tagsEl.replaceChildren();
        for (const value of [teacherId, subjectId]) {
          const tag = document.createElement('span');
          tag.className = 'tag-keyword';
          tag.textContent = value;
          tagsEl.append(tag);
        }
      }
      if (bodyEl) bodyEl.innerHTML = markdownToHtml(data.content || '', { base: pageBase() });

      if (data.source?.fileId && data.source.type === 'pdf') {
        currentSource = data.source;
        renderSourceMeta();
        document.getElementById('note-source')?.classList.remove('hidden');
        document.getElementById('note-source')?.classList.add('flex');
        document.getElementById('note-open-source')?.addEventListener('click', async (event) => {
          const button = event.currentTarget;
          button.disabled = true;
          try { await openUploadedFile(currentSource.fileId); }
          catch (error) { showError(error.message || t('note.sourceFailed')); }
          finally { button.disabled = false; }
        });
        document.getElementById('note-download-source')?.addEventListener('click', async (event) => {
          const button = event.currentTarget;
          button.disabled = true;
          try { await downloadUploadedFile(currentSource.fileId, currentSource.originalName || 'document.pdf'); }
          catch (error) { showError(error.message || t('note.sourceFailed')); }
          finally { button.disabled = false; }
        });
      }

      loading?.classList.add('hidden');
      article?.classList.remove('hidden');
    } catch (err) {
      if (err.status === 401) {
        goLogin(t('note.sessionExpired'));
        return;
      }
      showError(err.message || t('note.readFailed'));
    }
  })();

  document.addEventListener('wikinb:locale-change', renderSourceMeta);
</script>
