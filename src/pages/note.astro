---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Note" description="登入後由 Auth 讀取筆記（不依賴靜態建置）">
  <div class="animate-fadeIn mx-auto max-w-3xl">
    <div id="note-loading" class="kc-card p-8 text-center text-kc-muted" data-i18n="note.checking">Checking sign-in…</div>
    <div id="note-gate" class="kc-card hidden p-8 text-center text-kc-muted">
      <p class="mb-3" data-i18n="note.gate">This note is available only to signed-in Kang Chiao users.</p>
      <a id="note-login-link" href={`${base}login`} class="kc-btn-primary inline-flex" data-i18n="note.goLogin">Go to login</a>
    </div>
    <div id="note-error" class="kc-card hidden border border-red-200 bg-red-50/80 p-6 text-red-800"></div>

    <article id="note-article" class="note-reader hidden">
      <div class="note-reader-toolbar"><button id="note-copy" type="button" class="wiki-fs-btn wiki-copy-btn" data-i18n-aria="reader.copy" aria-label="Copy link"><span class="wiki-copy-label">copy</span></button><button id="note-maximize" type="button" class="wiki-fs-btn" aria-label="Expand reader"><span class="wiki-fs-icon" aria-hidden="true">⛶</span></button></div>
      <div class="wiki-reader-body">
      <header class="mb-8">
        <div id="note-tags" class="mb-3 flex flex-wrap items-center gap-2"></div>
        <h1 id="note-title" class="font-display text-3xl font-bold text-kc-blue-deep md:text-4xl"></h1>
        <p id="note-meta" class="mt-2 text-sm text-kc-muted"></p>
      </header>
      <div id="note-document-downloads" class="mb-5 hidden flex-wrap gap-2"><button id="note-document-markdown" type="button" class="kc-btn-secondary" data-i18n="document.markdown">Download Markdown</button></div>
      <div id="note-body" class="kc-card kc-core-card wiki-content p-6 md:p-10"></div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}search`} class="kc-btn-ghost">← WikiNB</a>
        <a href={`${base}my-notes`} class="kc-btn-ghost" data-i18n="home.myNotes">My documents</a>
      </div>
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  import {
    clearSessionHint,
    hasSessionHint,
    readWikiFile,
    requireLogin,
  } from '../scripts/auth-client.js';
  import { loginHrefWithNext, markdownToHtml } from '../scripts/md-render.js';
  import { t } from '../scripts/i18n.js';
  import {createReaderControls,bindReaderCopy} from '../scripts/reader-controls.js';
  import {readSchoolDocuments,downloadSchoolDocument} from '../scripts/shared-documents.js';

  function pageBase() {
    return document.documentElement.dataset.base || '/WikiNB-KCIS/';
  }

  const params = new URLSearchParams(window.location.search);
  const teacherId = params.get('teacherId') || '';
  const subjectId = params.get('subjectId') || '';
  const slug = params.get('slug') || '';
  const fileId=params.get('file')||'';

  const loading = document.getElementById('note-loading');
  const gate = document.getElementById('note-gate');
  const errEl = document.getElementById('note-error');
  const article = document.getElementById('note-article');
  const loginLink = document.getElementById('note-login-link');
  bindReaderCopy(document.getElementById('note-copy'), () => location.href);
  const reader = createReaderControls(article, document.getElementById('note-maximize'));

  let sharedDocument=null;
  let sharedRevision=0;
  function renderDocumentKeywords(){
    const tags=document.getElementById('note-tags');tags.replaceChildren();
    for(const word of sharedDocument?.keywords||[]){const tag=document.createElement('span');tag.className='tag-keyword';tag.textContent=word==='教職員'?t('account.staff'):word==='學生'?t('account.student'):word;tags.append(tag);}
  }
  document.addEventListener('wikinb:locale-change',()=>{if(sharedDocument){renderDocumentKeywords();if(!sharedDocument.markdown)document.getElementById('note-body').textContent=t('document.noMarkdown');}});
  async function loadSharedDocument(){
    const revision=++sharedRevision,data=await readSchoolDocuments('/files/'+encodeURIComponent(fileId));if(revision!==sharedRevision)return;sharedDocument=data;
    document.title=(data.title||data.filename)+' · WikiNB KCIS';
    document.getElementById('note-title').textContent=data.title||data.filename;
    renderDocumentKeywords();
    document.getElementById('note-meta').textContent=data.filename;
    const body=document.getElementById('note-body');body.innerHTML=markdownToHtml(String(data.markdown||'').replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/,''),{base:pageBase(),linkifyWiki:false});
    const {getAuthUrl}=await import('../scripts/auth-client.js');
    body.querySelectorAll('a[href],img[src]').forEach(node=>{const attribute=node.tagName==='IMG'?'src':'href',value=node.getAttribute(attribute);if(value?.startsWith('/api/library/'))node.setAttribute(attribute,getAuthUrl()+value);});
    if(!data.markdown)body.textContent=t('document.noMarkdown');
    document.getElementById('note-document-downloads').classList.remove('hidden');document.getElementById('note-document-downloads').classList.add('flex');document.getElementById('note-document-markdown').hidden=!data.markdown;
    loading.classList.add('hidden');gate.classList.add('hidden');article.classList.remove('hidden');if(params.get('fs')==='1')reader.expand();
  }
  for(const [id,converted] of [['note-document-markdown',true]])document.getElementById(id).addEventListener('click',async event=>{const button=event.currentTarget;button.disabled=true;try{await downloadSchoolDocument(fileId,sharedDocument.filename,converted);}catch(error){showError(error.message);}finally{button.disabled=false;}});
  window.addEventListener('kcis:account-updated',event=>{if(fileId&&sharedDocument&&event.detail?.user)event.detail.waitUntil?.(loadSharedDocument());});
  document.addEventListener('wikinb:auth-change',event=>{
    if(!fileId)return;
    if(!event.detail?.loggedIn){reader.restore();sharedRevision++;sharedDocument=null;article.classList.add('hidden');document.getElementById('note-body').replaceChildren();document.getElementById('note-tags').replaceChildren();loading.classList.add('hidden');gate.classList.remove('hidden');}
    else if(!sharedDocument)void loadSharedDocument().catch(error=>{if(![401,403].includes(error.status))showError(error.message);});
  });

  const next = `${window.location.pathname}${window.location.search}`;
  const loginUrl = loginHrefWithNext(next, pageBase());
  if (loginLink) loginLink.setAttribute('href', loginUrl);

  function showError(msg) {
    loading?.classList.add('hidden');
    gate?.classList.add('hidden');
    if (errEl) {
      errEl.textContent = msg || t('note.openFailed');
      errEl.classList.remove('hidden');
    }
  }

  function goLogin(reason) {
    loading?.classList.add('hidden');
    if (gate) {
      const p = gate.querySelector('p');
      if (p && reason) p.textContent = reason;
      gate.classList.remove('hidden');
    }
    // 無 token：立刻走；有失效 token：清掉再走
    if (!hasSessionHint()) {
      window.location.replace(loginUrl);
      return;
    }
    clearSessionHint();
    window.location.replace(loginUrl);
  }

  (async () => {
    if(fileId){
      if(!/^[a-f0-9-]{36}$/.test(fileId)){showError('Document not found');return;}
      try{await loadSharedDocument();}catch(error){if([401,403].includes(error.status)){loading.classList.add('hidden');gate.classList.remove('hidden');}else showError(error.message);}
      return;
    }
    if (!subjectId || !slug) {
      showError(t('note.missingSubject'));
      return;
    }
    if (!teacherId) {
      showError(t('note.missingTeacher'));
      return;
    }

    // github.io 必須靠 local token（跨站 cookie 不可用）→ 無提示立刻登入，不等待
    const onLocal =
      location.hostname === '127.0.0.1' || location.hostname === 'localhost';
    if (!hasSessionHint() && !onLocal) {
      goLogin(t('note.loginRequired'));
      return;
    }

    // 唯一可信檢查：Auth /api/auth/me（fail-closed）
    const session = await requireLogin({
      timeoutMs: hasSessionHint() ? 3500 : 2000,
    });
    if (!session.authenticated) {
      goLogin(
        session.offline
          ? t('note.authUnavailable')
          : t('note.loginRequired'),
      );
      return;
    }

    if (loading) loading.textContent = t('note.loading');

    try {
      const data = await readWikiFile({ subjectId, slug, teacherId });
      const title = data.title || slug;
      document.title = `${title} · WikiNB KCIS`;
      const titleEl = document.getElementById('note-title');
      const bodyEl = document.getElementById('note-body');
      const tagsEl = document.getElementById('note-tags');
      const metaEl = document.getElementById('note-meta');
      if (titleEl) titleEl.textContent = title;
      if (metaEl) {
        metaEl.textContent = `${data.storage || 'live'} · ${teacherId}/${subjectId}/${slug}.md`;
      }
      if (tagsEl) {
        tagsEl.replaceChildren();
        for (const value of [teacherId, subjectId]) {
          const tag = document.createElement('span');
          tag.className = 'tag-keyword';
          tag.textContent = value;
          tagsEl.append(tag);
        }
      }
      if (bodyEl) bodyEl.innerHTML = markdownToHtml(data.content || '', { base: pageBase() });

      loading?.classList.add('hidden');
      article?.classList.remove('hidden');if(params.get('fs')==='1')reader.expand();
    } catch (err) {
      if (err.status === 401) {
        goLogin(t('note.sessionExpired'));
        return;
      }
      showError(err.message || t('note.readFailed'));
    }
  })();


</script>
