---
/**
 * /wiki/... 僅作舊連結相容：立刻轉到 /note 或 login，不內嵌正文、不長時間等待 Auth。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllWikiPages, getWikiPage } from '../../lib/wiki';

export function getStaticPaths() {
  return getAllWikiPages({ includeDrafts: true }).map((page) => ({
    params: { slug: page.slug },
  }));
}

const { slug } = Astro.params;
const page = getWikiPage(slug!);
const base = import.meta.env.BASE_URL;

if (!page) {
  return Astro.redirect(`${base}404`);
}

const parts = String(slug || '').split('/').filter(Boolean);
const teacherId = page.teacherId || (parts[0] === 'teachers' ? parts[1] : '');
const subjectId = page.subjectId || (parts[0] === 'teachers' ? parts[2] : '');
const noteSlug =
  parts[0] === 'teachers' && parts.length >= 4 ? parts.slice(3).join('/') : parts[parts.length - 1];

const notePath = `${base}note?teacherId=${encodeURIComponent(teacherId)}&subjectId=${encodeURIComponent(subjectId)}&slug=${encodeURIComponent(noteSlug)}`;
const loginPath = `${base}login?next=${encodeURIComponent(notePath)}`;
---

<BaseLayout title={page.title} description="筆記僅供康橋登入用戶閱讀">
  <div class="animate-fadeIn mx-auto max-w-lg">
    <div class="kc-card p-8 text-center">
      <p class="font-display text-xl font-bold text-kc-blue-deep">{page.title}</p>
      <p class="mt-2 text-sm text-kc-muted">正在開啟…</p>
      <noscript>
        <p class="mt-4 text-sm text-kc-muted">請先登入後閱讀此筆記。</p>
        <a href={loginPath} class="kc-btn-primary mt-4 inline-flex">前往登入</a>
      </noscript>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ notePath, loginPath }}>
  // 同步判斷：有 token 提示 → note；否則 → login。真正權限在 /note。
  let hasHint = false;
  try {
    hasHint = Boolean(localStorage.getItem('wikinb_kcis_token'));
  } catch {
    hasHint = false;
  }
  window.location.replace(hasHint ? notePath : loginPath);
</script>
