---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="校內資料庫" description="WikiNB KCIS">
  <section class="library-shell">
    <header class="library-heading"><div><p class="library-kicker">WikiNB · KCIS</p><h1 data-i18n="library.title">校內資料庫</h1></div><button id="library-upload" class="library-button" type="button" hidden><span data-i18n="library.upload">上傳檔案</span></button><input id="library-file" type="file" hidden /></header>
    <p id="library-status" role="status"></p>
    <div id="library-gate"><p data-i18n="library.login">請先使用校內信箱登入</p><a id="library-login" class="library-button" href="https://ai-tools.kcis.kainnne.com/" data-i18n="nav.login">登入</a></div>
    <div id="library-content" hidden>
      <div class="library-filters"><div role="group" aria-label="Uploader"><button class="active" data-role="" data-i18n="library.all">全部</button><button data-role="teachers" data-i18n="library.teachers">老師</button><button data-role="students" data-i18n="library.students">學生</button></div><input id="library-query" type="search" data-i18n-placeholder="library.search" placeholder="搜尋資料" aria-label="Search documents" /></div>
      <div id="library-categories" class="library-categories"></div>
      <div class="library-columns"><section><div id="library-files" class="library-files"></div><article id="library-reader" hidden><button id="library-close" data-i18n="library.back">返回列表</button><h2 id="library-reader-title"></h2><button id="library-download" class="library-button" data-i18n="library.download">下載原檔</button><pre id="library-markdown"></pre></article></section>
        <aside class="library-chat"><h2 data-i18n="library.ask">詢問資料</h2><form id="library-ask"><label for="library-question" data-i18n="library.question">你的問題</label><textarea id="library-question" maxlength="4000" required></textarea><button class="library-button" data-i18n="library.send">提問</button></form><div id="library-answer" aria-live="polite"></div><div id="library-sources"></div></aside>
      </div>
    </div>
  </section>
</BaseLayout>
<style is:global>
  .library-shell{max-width:1100px;margin:10px auto}.library-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.library-kicker{font-size:12px;letter-spacing:.12em;color:#686fa0}.library-heading h1{font-size:clamp(26px,4vw,38px);font-weight:750;color:#354279;letter-spacing:-.025em}.library-button{display:inline-flex;border:1px solid #636db0;background:#5b63a0;color:white;padding:10px 16px;border-radius:10px;cursor:pointer;transition:transform .15s,background .15s;font-weight:650}.library-button:hover{background:#454e8b;transform:translateY(-1px)}.library-button:disabled{opacity:.5;cursor:wait}.library-button:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #a8b1e6;outline-offset:3px}#library-status{color:#68637d;min-height:24px;margin-bottom:12px}#library-gate{border:1px solid #dce0ef;background:#fff;border-radius:16px;padding:32px}#library-gate p{margin-bottom:18px}.library-filters{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.library-filters button{border-bottom:2px solid transparent;padding:9px 14px;color:#657094}.library-filters button.active{border-color:#6861a0;color:#3b457d;font-weight:700}.library-filters input{background:#fff;border:1px solid #ced5e7;border-radius:10px;padding:10px 12px;width:min(320px,50%)}.library-categories{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px}.library-categories button{border:1px solid #d1d8ec;background:#fff;border-radius:20px;padding:7px 12px;font-size:13px;color:#535e87;transition:background .15s}.library-categories button:hover,.library-categories button.active{border-color:#7477b8;background:#ececfa;color:#424582}.library-columns{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:28px}.library-files{display:grid;gap:12px}.library-file{display:block;width:100%;text-align:left;background:#fff;border:1px solid #dee2ef;border-radius:14px;padding:20px;transition:border-color .15s,transform .15s}.library-file:hover{border-color:#7c82b7;transform:translateY(-2px)}.library-file strong{display:block;font-size:16px;color:#38457b;overflow-wrap:anywhere}.library-file small{display:block;color:#79819b;margin-top:8px}.library-chat{background:#f6f6fc;border:1px solid #dddff0;padding:22px;border-radius:16px;align-self:start;position:sticky;top:90px}.library-chat h2{font-size:19px;font-weight:700;margin-bottom:20px}.library-chat form{display:grid;gap:10px}.library-chat label{font-size:13px;color:#697299}.library-chat textarea{min-height:110px;border:1px solid #c9cee5;border-radius:10px;padding:10px;background:#fff;resize:vertical;width:100%}#library-answer{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:24px;font-size:14px;line-height:1.75}#library-sources button{display:block;margin-top:10px;color:#5c62a3;text-decoration:underline;text-align:left;font-size:13px}#library-reader{background:white;border:1px solid #dee2ef;border-radius:16px;padding:24px}#library-reader h2{font-weight:700;font-size:22px;margin:16px 0;overflow-wrap:anywhere}#library-markdown{font-family:inherit;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:24px;line-height:1.8;font-size:15px}[hidden]{display:none!important}@media(max-width:800px){.library-columns{grid-template-columns:1fr}.library-chat{position:static}.library-heading{align-items:flex-start}.library-filters{flex-wrap:wrap}.library-filters input{width:100%}.library-button{font-size:13px;padding:9px 12px}.library-heading{gap:10px}}
</style>
<script>
  import { getAuthUrl } from '../scripts/auth-client.js';
  import { getLocale,t } from '../scripts/i18n.js';
  const el=(id)=>document.getElementById(id);
  let categories=[],files=[],role='',category='',current=null,busy=false,authenticated=false;
  const base=getAuthUrl();
  const trial=import.meta.env.PUBLIC_TRIAL_URL;
  if(trial&&!['localhost','127.0.0.1'].includes(location.hostname)&&new URL(trial).origin!==location.origin)location.replace(new URL('library/'+location.search+location.hash,trial).href);
  const portal=['localhost','127.0.0.1'].includes(location.hostname)?`http://${location.hostname}:3000/`:import.meta.env.PUBLIC_PORTAL_URL||'https://ai-tools.kcis.kainnne.com/';
  const loginUrl=new URL(portal);loginUrl.searchParams.set('signin','1');loginUrl.searchParams.set('returnTo',location.href);
  el('library-login').setAttribute('href',loginUrl.href);
  const accountLink=el('school-account');if(accountLink)accountLink.href=loginUrl.href;
  async function request(endpoint,body){
    if(!base)throw Error(t('library.disconnected'));

    const response=await fetch(base+'/api'+endpoint,{method:body===undefined?'GET':'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body),signal:AbortSignal.timeout(endpoint.includes('chat')?240000:120000)});
    if(!response.ok){const data=await response.json().catch(()=>({}));throw Object.assign(new Error(data.error||t('library.failed')),{status:response.status});}return response.json();
  }
  function status(text=''){el('library-status').textContent=text;}
  async function perform(fn){if(busy)return;busy=true;status(t('library.loading'));document.querySelectorAll('#library-content button').forEach(b=>b.disabled=true);try{await fn();status();}catch(e){status(e.status===401||e.status===403?t('library.login'):e.message);if(e.status===401||e.status===403){el('library-content').hidden=true;el('library-gate').hidden=false;el('library-upload').hidden=true;}}finally{busy=false;document.querySelectorAll('#library-content button').forEach(b=>b.disabled=false);}}
  function categoryName(id){const c=categories.find(c=>c.id===id);return c?c[getLocale()==='en'?'en':'zh']:id;}
  function render(){
    const container=el('library-categories');container.replaceChildren();
    for(const c of [{id:'',zh:'全部領域',en:'All subjects'},...categories]){const b=document.createElement('button');b.textContent=c[getLocale()==='en'?'en':'zh'];b.className=c.id===category?'active':'';b.setAttribute('aria-pressed',String(c.id===category));b.onclick=()=>{category=c.id;render();};container.append(b);}
    const q=el('library-query').value.toLowerCase(),list=el('library-files');list.replaceChildren();
    const visible=files.filter(f=>(!role||f.role===role)&&(!category||f.category===category)&&(!q||(f.filename+' '+f.preview).toLowerCase().includes(q)));
    for(const f of visible){const b=document.createElement('button');b.className='library-file';const title=document.createElement('strong');title.textContent=f.filename;const meta=document.createElement('small');meta.textContent=`${categoryName(f.category)} · ${f.uploader} · ${t(f.readable?'library.readable':f.status==='conversion-failed'?'library.conversionFailed':'library.stored')}`;b.append(title,meta);b.onclick=()=>perform(()=>openFile(f.id));list.append(b);}
    if(!visible.length){const empty=document.createElement('p');empty.textContent=t('library.empty');list.append(empty);}
  }
  async function openFile(id){current=await request('/library/files/'+id);el('library-files').hidden=true;el('library-reader').hidden=false;el('library-reader-title').textContent=current.filename;el('library-markdown').textContent=current.markdown||t('library.stored');}
  el('library-close').onclick=()=>{el('library-reader').hidden=true;el('library-files').hidden=false;current=null;};
  el('library-download').onclick=()=>perform(async()=>{const response=await fetch(base+'/api/library/files/'+current.id+'/download',{credentials:'include',headers:{}});if(!response.ok)throw Error(t('library.failed'));const url=URL.createObjectURL(await response.blob());const a=document.createElement('a');a.href=url;a.download=current.filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),60000);});
  document.querySelectorAll('[data-role]').forEach(b=>b.onclick=()=>{role=b.dataset.role;document.querySelectorAll('[data-role]').forEach(item=>{item.classList.toggle('active',item===b);item.setAttribute('aria-pressed',String(item===b));});render();});
  el('library-query').oninput=render;
  el('library-upload').onclick=()=>el('library-file').click();
  el('library-file').onchange=()=>perform(async()=>{const file=el('library-file').files?.[0];if(!file)return;if(file.size>12*1024*1024)throw Error(t('library.size'));const bytes=new Uint8Array(await file.arrayBuffer());let binary='';for(let i=0;i<bytes.length;i+=32768)binary+=String.fromCharCode(...bytes.slice(i,i+32768));await request('/library/upload',{filename:file.name,contentBase64:btoa(binary)});const data=await request('/library');files=data.files;el('library-file').value='';render();});
  el('library-ask').onsubmit=e=>{e.preventDefault();perform(async()=>{el('library-answer').textContent=t('library.loading');el('library-sources').replaceChildren();try{const result=await request('/library/chat',{message:el('library-question').value});el('library-answer').textContent=result.answer;for(const source of result.sources){const b=document.createElement('button');b.textContent=source.title;b.onclick=()=>perform(()=>openFile(source.id));el('library-sources').append(b);}}catch(e){el('library-answer').textContent='';throw e;}});};
  document.addEventListener('wikinb:locale-change',()=>{if(authenticated)render();});
  async function refreshAccess(){
    try{const session=await request('/auth/shared-session');const data=await request('/library');authenticated=true;categories=data.categories;files=data.files;el('library-gate').hidden=true;el('library-content').hidden=false;el('library-upload').hidden=false;
      if(accountLink){accountLink.textContent=session.user.nickname||session.user.name;accountLink.removeAttribute('data-i18n');const accountUrl=new URL(portal);accountUrl.searchParams.set('account','1');accountUrl.searchParams.set('returnTo',location.href);accountLink.href=accountUrl.href;}render();
    }catch(error){authenticated=false;files=[];current=null;el('library-content').hidden=true;el('library-gate').hidden=false;el('library-upload').hidden=true;el('library-answer').textContent='';el('library-sources').replaceChildren();el('library-markdown').textContent='';if(accountLink){accountLink.setAttribute('data-i18n','nav.login');accountLink.textContent=t('nav.login');accountLink.href=loginUrl.href;}throw error;}
  }
  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&!busy)perform(refreshAccess);});
  window.addEventListener('pageshow',()=>{if(!busy)perform(refreshAccess);});
  perform(refreshAccess);
</script>
