---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import { getAllWikiPages, getSearchIndex } from '../lib/wiki';

const pages = getAllWikiPages();
/** 公開頁不內嵌全文 HTML／內文，避免未登入即可從原始碼讀筆記 */
const searchIndex = getSearchIndex(pages).map(({ html: _h, bodyText: _b, ...rest }) => ({
  ...rest,
  html: '',
  bodyText: '',
}));
---

<BaseLayout title="WikiNB" description="搜尋與瀏覽康橋教學筆記">
  <div class="animate-fadeIn">
    <div class="mb-6 text-center md:text-left">
      <h1 class="font-display text-4xl font-bold md:text-5xl">
        <span class="brand-gradient-text" data-i18n="search.title">WikiNB</span>
      </h1>
    </div>

    <div class="mx-auto max-w-3xl">
      <SearchBar size="lg" showButton={true} action="/search" />
    </div>

    <p id="search-meta" class="mt-4 text-center text-sm text-kc-muted md:text-left"></p>

    <div
      id="search-results"
      data-search-results
      class="wiki-scroll kc-card mx-auto mt-6 max-w-3xl divide-y overflow-hidden"
    ></div>
    <div id="search-empty" class="kc-card mx-auto mt-6 hidden max-w-3xl p-8 text-center text-kc-muted"></div>
  </div>

  <script>
    import { createWikiSearch } from '../scripts/wiki-search.js';
    import {schoolDocumentsIndex} from '../lib/wiki-documents.js';
    import {readSchoolDocuments} from '../scripts/shared-documents.js';
    import {
      fetchMe,
      hasSessionHint,
      requireLogin,
    } from '../scripts/auth-client.js';
    import {t} from '../scripts/i18n.js';

    const staticIndex = JSON.parse(document.getElementById('search-data')!.textContent!);
    // 連結目標用 token 提示同步決定；真正權限在 /note
    const { mount, getQueryFromUrl, setIndex, setAuthed, setStatus } = createWikiSearch(staticIndex, {
      authed: hasSessionHint(),
    });

    const input = document.querySelector('input[name="q"]') as HTMLInputElement;
    const form = input?.closest('form');
    const resultsEl = document.getElementById('search-results')!;
    const emptyEl = document.getElementById('search-empty')!;
    const metaEl = document.getElementById('search-meta')!;

    const { runSearch } = mount({ input, form, resultsEl, emptyEl, metaEl, syncUrl: true });

    function pageBase() {
      return document.documentElement.dataset.base || '/WikiNB-KCIS/';
    }

    let catalogKey='',catalogGeneration=0,catalogLoading=null;
    function loadLiveCatalog(user) {
      const key=[user.email,user.role,user.updatedAt].join('|');
      if(key===catalogKey)return catalogLoading||Promise.resolve();
      catalogKey=key;const generation=++catalogGeneration;
      catalogLoading=loadCatalog(user,generation);return catalogLoading;
    }
    async function loadCatalog(user,generation) {
      try {
        setStatus('library.documentsLoading');runSearch();
        const school=await readSchoolDocuments();
        if(generation!==catalogGeneration)return;
        setIndex(schoolDocumentsIndex(school.files,school.categories,pageBase()));
        setStatus('');
        runSearch();
      } catch(error) {
        if(generation!==catalogGeneration)return;
        catalogKey='';
        setStatus('library.documentsFailed');runSearch();
      }

    }

    async function initAuthAndCatalog() {
      const session = await fetchMe();
      if (!session.authenticated) {
        catalogGeneration++;catalogKey='';setIndex(staticIndex);setStatus(session.offline?'library.documentsFailed':'library.gate');
        setAuthed(false);
        runSearch();
        return;
      }
      setAuthed(true);
      await loadLiveCatalog(session.user);
    }

    const q = getQueryFromUrl();
    if (q && input) input.value = q;
    setStatus('library.documentsLoading');runSearch();
    initAuthAndCatalog();

    document.addEventListener('wikinb:locale-change', () => runSearch());
    document.addEventListener('wikinb:auth-change', (ev) => {
      const loggedIn = Boolean(ev.detail?.loggedIn);
      setAuthed(loggedIn);
      if(loggedIn)void loadLiveCatalog(ev.detail.user);
      else{catalogGeneration++;catalogKey='';setIndex(staticIndex);setStatus('library.gate');runSearch();}
    });
    window.addEventListener('kcis:account-updated',event=>{if(event.detail?.user)event.detail.waitUntil?.(loadLiveCatalog(event.detail.user));});
  </script>

  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<style>
  #search-results > :not([hidden]) ~ :not([hidden]) {
    border-color: rgba(27, 79, 156, 0.1);
  }

  .wiki-scroll {
    max-height: min(75vh, 900px);
    overflow-y: auto;
    scroll-behavior: smooth;
  }

  .wiki-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .wiki-scroll::-webkit-scrollbar-thumb {
    background: rgba(27, 79, 156, 0.28);
    border-radius: 9999px;
  }

  .wiki-title-link:hover {
    text-decoration: underline;
    text-decoration-color: rgba(107, 61, 154, 0.4);
    text-underline-offset: 4px;
  }
</style>
