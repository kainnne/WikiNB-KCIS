---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSearch from '../components/HomeSearch.astro';
import RecentDocuments from '../components/RecentDocuments.astro';
import sites from '../../config/sites.json';

---

<BaseLayout title="WikiNB" description={sites.brand.tagline}>
  <section class="school-home-hero">
    <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl"><span class="brand-gradient-text">WikiNB</span></h1>
    <a href={`${import.meta.env.BASE_URL}codex`} class="home-ai-entry" aria-label="KCIS AI"><span data-i18n="nav.gemini">KCIS AI</span><svg class="home-ai-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
    <div class="home-search-wrap"><HomeSearch /></div>
  </section>

  <RecentDocuments />
</BaseLayout>

<style>
  .school-home-hero{display:flex;align-items:center;flex-direction:column;gap:28px;padding:48px 0 56px;text-align:center}.school-home-hero h1{animation:kc-rise .9s var(--ease) backwards}.home-search-wrap{width:min(100%,600px);margin-top:4px;animation:kc-rise .9s var(--ease) .16s backwards}
  /* The one dark-glass highlight on the page. The pointer sheen is the material catching light. */
  .home-ai-entry{--light-x:50%;--light-y:30%;position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:20px;min-width:230px;min-height:68px;padding:16px 30px 16px 34px;border:1px solid rgba(255,255,255,.38);border-radius:999px;color:#fff;background:linear-gradient(145deg,rgba(255,140,200,.3),transparent 52%),rgba(64,22,88,.6);-webkit-backdrop-filter:blur(25px) saturate(1.25);backdrop-filter:blur(25px) saturate(1.25);box-shadow:inset 0 1px rgba(255,255,255,.3),inset 0 -2px rgba(30,0,40,.18),0 22px 50px -18px rgba(64,22,88,.55);font-family:Comfortaa,Nunito,'Noto Sans TC',sans-serif;font-size:23px;font-weight:700;letter-spacing:.01em;animation:kc-rise .9s var(--ease) .08s backwards;transition:transform .45s var(--ease),box-shadow .45s var(--ease)}
  .home-ai-entry::after{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:radial-gradient(220px circle at var(--light-x) var(--light-y),rgba(255,255,255,.24),transparent 72%);opacity:0;transition:opacity .35s var(--ease)}
  .home-ai-arrow{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform .45s var(--ease)}
  .home-ai-entry:hover{transform:translateY(-3px);box-shadow:inset 0 1px rgba(255,255,255,.34),inset 0 -2px rgba(30,0,40,.18),0 28px 60px -20px rgba(64,22,88,.6)}.home-ai-entry:hover::after,.home-ai-entry:active::after{opacity:1}.home-ai-entry:hover .home-ai-arrow{transform:translateX(3px)}
  .home-ai-entry:active{transform:translateY(1px);box-shadow:inset 0 2px 6px rgba(30,0,40,.35),0 10px 24px -16px rgba(64,22,88,.5)}.home-ai-entry:focus-visible{outline:2px solid var(--focus);outline-offset:3px}
  @media(max-width:640px){.school-home-hero{padding:28px 0 40px;gap:24px}.home-ai-entry{min-width:214px;min-height:64px;font-size:21px}}
  @media(max-height:520px) and (orientation:landscape){.school-home-hero{padding:8px 0 32px;gap:18px}.home-ai-entry{min-height:56px}}
  @media(prefers-reduced-motion:reduce){.home-ai-entry,.home-ai-entry::after,.home-ai-arrow{transition:none;transform:none!important}}
</style>
<script>
  const entry=document.querySelector('.home-ai-entry');
  const motion=window.matchMedia('(prefers-reduced-motion: reduce)'),pointer=window.matchMedia('(hover: hover) and (pointer: fine)');
  entry?.addEventListener('pointermove',event=>{
    if(motion.matches||!pointer.matches)return;const rect=entry.getBoundingClientRect(),x=(event.clientX-rect.left)/rect.width,y=(event.clientY-rect.top)/rect.height;
    entry.style.setProperty('--light-x',`${x*100}%`);entry.style.setProperty('--light-y',`${y*100}%`);entry.style.setProperty('--tilt-x',`${(0.5-y)*5}deg`);entry.style.setProperty('--tilt-y',`${(x-0.5)*5}deg`);
  });
  entry?.addEventListener('pointerleave',()=>{for(const name of ['--light-x','--light-y','--tilt-x','--tilt-y'])entry.style.removeProperty(name);});
</script>
