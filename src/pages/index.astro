---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSearch from '../components/HomeSearch.astro';
import WikiCard from '../components/WikiCard.astro';
import { getAllWikiPages } from '../lib/wiki';
import sites from '../../config/sites.json';

const pages = getAllWikiPages();
const recent = pages.slice(0, 6);
---

<BaseLayout title="WikiNB" description={sites.brand.tagline}>
  <section class="school-home-hero">
    <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl"><span class="brand-gradient-text">WikiNB</span></h1>
    <a href={`${import.meta.env.BASE_URL}codex`} class="kc-btn-ai home-ai-entry" data-i18n="nav.gemini">KCIS AI</a>
    <div class="home-search-wrap"><HomeSearch /></div>
  </section>

  {recent.length > 0 && (
    <section class="animate-fadeIn">
      <h2 class="mb-6 font-display text-2xl font-bold text-kc-blue-deep">

        <span data-i18n="home.recent">Recently updated</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((page) => (
          <WikiCard
            slug={page.slug}
            title={page.title}
            description={page.description}
            teacher={page.teacher}
            subject={page.subject}
            subjectEn={page.subjectEn}
            date={page.date}
            teacherId={page.teacherId}
            subjectId={page.subjectId}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .school-home-hero{display:flex;align-items:center;flex-direction:column;gap:28px;padding:40px 0 48px;text-align:center}.home-ai-entry{min-width:172px;padding:13px 30px;font-size:20px}.home-search-wrap{width:min(100%,600px);margin-top:4px}@media(max-width:640px){.school-home-hero{padding:24px 0 36px;gap:24px}.home-ai-entry{font-size:18px}}
</style>
