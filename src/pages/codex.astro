---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/codex.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="KCIS AI" description="KCIS AI" pageClass="school-ai-page">
  <div class="animate-fadeIn codex-page">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-2 sm:gap-4">
      <div class="min-w-0">
        <h1 class="codex-page-title text-2xl font-bold text-kc-blue-deep sm:text-3xl md:text-4xl">
          <span
            class="bg-gradient-to-r from-kc-blue to-kc-purple bg-clip-text text-transparent"
            data-i18n="gemini.title">KCIS AI</span
          >
        </h1>
      </div>

    </div>

    <div id="codex-gate" class="kc-card hidden p-8 text-center">
      <p class="text-kc-muted">
        <span data-i18n="gemini.gate">Please sign in to use KCIS AI.</span>
        <a href={`${base}login`} data-school-signin class="font-semibold text-kc-blue" data-i18n="nav.login">Log in</a>
      </p>
    </div>

    <div id="codex-offline" class="kc-card hidden border border-amber-200 bg-amber-50/50 p-6 text-center text-amber-900"></div>

    <div id="codex-terminal" class="codex-terminal hidden">
      <div id="codex-output" class="codex-output">
        <div class="codex-line codex-line-assistant">
          <div class="codex-bubble codex-md wiki-content">
            <p data-i18n="gemini.welcome">I'm KCIS AI. I can help you find, summarize and explain school documents and AI Forum solutions.</p>
            <p class="text-sm text-kc-muted" data-i18n="gemini.firstReplyNote">Your first AI reply may take about 10–15 seconds.</p>
          </div>
        </div>
      </div>
      <section class="learning-prompts" aria-label="Suggested prompts">
        <div class="learning-prompt-heading"><span>Try a prompt</span><button id="learning-prompts-reset" type="button" class="kc-btn-ghost" aria-label="Show two different prompts">↻ Reset</button></div>
        <div id="learning-prompts-list" class="learning-prompts-list"></div>
      </section>
      <form id="codex-form" class="codex-input-row">

        <input
          id="codex-input"
          type="text"
          class="codex-input" aria-label="Ask about your wiki notes…" data-i18n-aria="gemini.placeholder"
          data-i18n-placeholder="gemini.placeholder"
          placeholder="Ask about your wiki notes…"
          autocomplete="off"
        />
        <button id="codex-stop" type="button" class="codex-stop kc-btn-ghost" hidden disabled data-i18n="gemini.stop">Stop</button>
        <button id="codex-send" type="submit" class="codex-send kc-btn-primary" data-i18n="gemini.send">Send</button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import {pickLearningPrompts} from '../lib/learning-prompts.js';
  import { t, getLocale, uiError } from '../scripts/i18n.js';
  import {
    checkAuthHealth,
    fetchMe,
    codexChatStream,
    fetchCodexModels,
    stopCodex,
  } from '../scripts/auth-client.js';
  import { markdownToHtml } from '../scripts/md-render.js';

  const gate = document.getElementById('codex-gate');
  const offline = document.getElementById('codex-offline');
  const terminal = document.getElementById('codex-terminal');
  const output = document.getElementById('codex-output');
  const form = document.getElementById('codex-form');
  const input = document.getElementById('codex-input');
  const sendBtn = document.getElementById('codex-send');
  const stopBtn = document.getElementById('codex-stop');

  let selectedPrompts=[];
  function resetLearningPrompts(){
    const container=document.getElementById('learning-prompts-list');if(!container)return;
    const pair=pickLearningPrompts(selectedPrompts);selectedPrompts=pair.map(item=>item.id);container.replaceChildren();
    for(const prompt of pair){const button=document.createElement('button');button.type='button';button.className='learning-prompt';button.textContent=prompt.label;button.title=prompt.text;button.onclick=()=>{if(running)return;input.value=prompt.text;input.focus();};container.append(button);}
  }
  document.getElementById('learning-prompts-reset')?.addEventListener('click',resetLearningPrompts);
  resetLearningPrompts();

  let abortController = null;
  let running = false;
  let fixedModel = 'gemini-3.1-flash-lite';
  /** @type {{ role: string, content: string }[]} */
  let chatHistory = [];


  function pageBase() {
    return document.documentElement.dataset.base || '/WikiNB-KCIS/';
  }

  function setBubbleText(bubble, text, role = 'assistant') {
    if (!bubble) return;
    if (role === 'assistant') {
      bubble.classList.add('codex-md', 'wiki-content');
      bubble.innerHTML = markdownToHtml(String(text ?? ''), {
        base: pageBase(),
        linkifyWiki: true,
      });
    } else {
      bubble.classList.remove('codex-md', 'wiki-content');
      bubble.textContent = text;
    }
  }

  function appendLine(text, role = 'assistant') {
    const line = document.createElement('div');
    line.className = `codex-line codex-line-${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'codex-bubble';
    setBubbleText(bubble, text, role);
    line.appendChild(bubble);
    output?.appendChild(line);
    output?.scrollTo({ top: output.scrollHeight, behavior: 'smooth' });
    return line;
  }

  function startElapsedTimer() {
    const startedAt = Date.now();
    const line = appendLine('0s', 'system');
    const bubble = line.querySelector('.codex-bubble');
    const id = setInterval(() => {
      const sec = Math.floor((Date.now() - startedAt) / 1000);
      if (bubble) bubble.textContent = `${sec}s`;
    }, 1000);
    return {
      stop() {
        clearInterval(id);
        const sec = Math.floor((Date.now() - startedAt) / 1000);
        if (bubble) bubble.textContent = t('gemini.totalTime', { sec });
        return sec;
      },
    };
  }

  function formatElapsed(ms) {
    const s = Math.floor(ms / 1000);
    const m = Math.floor(s / 60);
    const rem = s % 60;
    return m > 0 ? `${m}m ${String(rem).padStart(2, '0')}s` : `${rem}s`;
  }

  function setRunning(isRunning) {
    running = isRunning;
    if (sendBtn) sendBtn.disabled = isRunning;
    document.querySelectorAll('.learning-prompts button').forEach(button=>button.disabled=isRunning);
    if (stopBtn) {
      stopBtn.disabled = !isRunning;
      stopBtn.hidden = !isRunning;
      stopBtn.textContent = t('gemini.stop');
    }
    input?.toggleAttribute('disabled', isRunning);
  }

  async function loadModels() {
    try {
      const data = await fetchCodexModels();
      fixedModel = data.defaultModel || data.models?.[0]?.id || fixedModel;
      if (data.error) appendLine(uiError({message:data.error},t('gemini.connectFail')), 'error');
    } catch (err) {
      appendLine(uiError(err,t('gemini.connectFail')), 'error');
    }
  }

  function onLocaleChange() {
    if (stopBtn && !running) stopBtn.textContent = t('gemini.stop');
  }

  document.addEventListener('wikinb:locale-change', onLocaleChange);

  let initialized = false;
  let initializing = false;
  async function init() {
    if (initialized || initializing) return;
    initializing = true;
    const me = await fetchMe().catch(() => ({ authenticated: false }));
    if (!me.authenticated) {
      initializing = false;
      gate?.classList.remove('hidden');
      return;
    }
    const health = await checkAuthHealth();
    if (!health.online) {
      initializing = false;
      if (offline) {
        offline.textContent =
          t('gemini.apiOffline');
        offline.classList.remove('hidden');
      }
      return;
    }
    initialized = true;
    initializing = false;
    gate?.classList.add('hidden');
    offline?.classList.add('hidden');
    terminal?.classList.remove('hidden');
    await loadModels();
    onLocaleChange();
    input?.focus();
  }

  stopBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!running) return;
    stopBtn.disabled = true;
    stopBtn.textContent = t('gemini.stopping');
    try {
      await stopCodex();
    } catch {
      /* ignore */
    }
    abortController?.abort();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (running) return;
    const msg = input?.value?.trim();
    if (!msg) return;

    appendLine(msg, 'user');
    input.value = '';

    abortController = new AbortController();
    setRunning(true);
    const timer = startElapsedTimer();

    const progress = document.createElement('div');
    progress.className = 'codex-line codex-line-system';
    const progressBubble = document.createElement('div');
    progressBubble.className = 'codex-bubble';
    progressBubble.textContent = t('gemini.starting');
    progress.appendChild(progressBubble);
    output?.appendChild(progress);

    const liveWrap = document.createElement('div');
    liveWrap.className = 'codex-line codex-line-live';
    const liveBubble = document.createElement('div');
    liveBubble.className = 'codex-bubble';
    liveWrap.appendChild(liveBubble);
    output?.appendChild(liveWrap);

    let liveText = '';
    try {
      const result = await codexChatStream(
        msg,
        (ev) => {
          if (ev.type === 'status' || ev.type === 'event') {
            progressBubble.textContent = uiError({message:ev.message || ev.summary},t('gemini.working'));
          } else if (ev.type === 'delta' && ev.text) {
            progress.hidden=true;
            liveText += ev.text;
            setBubbleText(liveBubble, liveText, 'assistant');
            output?.scrollTo({ top: output.scrollHeight });
          }
        },
        {
          model: fixedModel,
          reasoningEffort: 'default',
          signal: abortController.signal,
          history: chatHistory.slice(-16),
        },
      );

      timer.stop();
      progress.remove();
      const finalText = result.answer || liveText || t('gemini.noResponse');
      chatHistory.push({ role: 'user', content: msg });
      if (!result.stopped) chatHistory.push({ role: 'assistant', content: finalText });
      if (chatHistory.length > 24) chatHistory = chatHistory.slice(-24);

      liveWrap.className = `codex-line ${result.stopped ? 'codex-line-system' : 'codex-line-assistant'}`;
      setBubbleText(liveBubble, finalText, result.stopped ? 'system' : 'assistant');
      appendLine(t('gemini.done', { time: formatElapsed(result.elapsedMs || 0) }), 'system');
    } catch (err) {
      timer.stop();
      progress.remove();
      liveWrap.remove();
      if (err?.name !== 'AbortError') appendLine(uiError(err,t('gemini.runFailed')), 'error');
      else appendLine(t('gemini.stopped'), 'system');
    } finally {
      setRunning(false);
      abortController = null;
      input?.removeAttribute('disabled');
      input?.focus();
    }
  });

  document.addEventListener('wikinb:auth-change', (event) => {
    if (event.detail?.loggedIn) void init();
  });
  init();
</script>
