---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/codex.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="KCIS AI" description="KCIS AI" pageClass="school-ai-page">
  <div class="animate-fadeIn codex-page">
    <div class="codex-heading mb-4 flex flex-wrap items-end justify-between gap-2 sm:gap-4">
      <div class="min-w-0">
        <h1 class="codex-page-title text-2xl font-bold text-kc-blue-deep sm:text-3xl md:text-4xl">
          <span
            class="bg-gradient-to-r from-kc-blue to-kc-purple bg-clip-text text-transparent"
            data-i18n="gemini.title">KCIS AI</span
          >
        </h1>
      </div>

      <div class="ai-window-controls">
        <button id="ai-language-change" type="button" class="ai-language-change" aria-label="Language">Language <span id="ai-language-current">EN / 中文</span></button>
        <button id="ai-expand" type="button" class="ai-expand" aria-label="Expand chat" title="Expand chat" aria-pressed="false"><svg data-expand-icon viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><svg data-restore-icon viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M3 8h5V3m8 0v5h5M8 21v-5H3m18 0h-5v5"/></svg></button>
      </div>
    </div>
    <dialog id="ai-language-dialog" class="ai-language-dialog" aria-labelledby="ai-language-title">
      <h2 id="ai-language-title">Language</h2>
      <div class="ai-language-options">
        <button type="button" data-ai-language="en" lang="en">EN</button>
        <button type="button" data-ai-language="zh-TW" lang="zh-TW">中文</button>
      </div>
    </dialog>

    <div id="codex-gate" class="kc-card hidden p-8 text-center">
      <p class="text-kc-muted">
        <span data-i18n="gemini.gate">Please sign in to use KCIS AI.</span>
        <a href={`${base}login`} data-school-signin class="font-semibold text-kc-blue" data-i18n="nav.login">Log in</a>
      </p>
    </div>

    <div id="codex-offline" class="kc-card hidden border border-amber-200 bg-amber-50/50 p-6 text-center text-amber-900"></div>

    <div id="codex-terminal" class="codex-terminal hidden">
      <div id="codex-output" class="codex-output">
        <div id="codex-intro" class="codex-line codex-line-assistant">
          <div class="codex-bubble codex-md wiki-content">
            <p data-i18n="gemini.welcome">I'm KCIS AI. I can help you find, summarize and explain school documents and AI Forum solutions.</p>
            <p class="text-sm text-kc-muted" data-i18n="gemini.firstReplyNote">Your first AI reply may take about 10–15 seconds.</p>
          </div>
        </div>
        <section class="learning-prompts" aria-label="Suggested prompts">
          <div id="learning-prompts-list" class="learning-prompts-list"></div>
          <button id="learning-prompts-reset" type="button" class="ai-reset" aria-label="Refresh options"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.1 6.4 M20 4v7h-7"/></svg></button>
        </section>
      </div>
      <form id="codex-form" class="codex-input-row">

        <input
          id="codex-input"
          type="text"
          class="codex-input" aria-label="Ask about your wiki notes…" data-i18n-aria="gemini.placeholder"
          data-i18n-placeholder="gemini.placeholder"
          placeholder="Ask about your wiki notes…"
          autocomplete="off"
        />
        <button id="codex-stop" type="button" class="codex-stop ai-action" hidden disabled aria-label="Stop" title="Stop"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"/></svg></button>
        <button id="codex-send" type="submit" class="codex-send ai-action" aria-label="Send" title="Send"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import {pickLearningPrompts,localizeLearningPrompt,learningPromptIcon} from '../lib/learning-prompts.js';
  import {chatMessage,completedChatHistory} from '../lib/chat-recovery.js';
  import {createChatInitialization} from '../lib/chat-initialization.js';
  import { uiError } from '../scripts/i18n.js';
  import en from '../locales/en.json';
  import zh from '../locales/zh-TW.json';
  import {
    checkAuthHealth,
    fetchMe,
    codexChatStream,
    fetchCodexModels,
    stopCodex,
  } from '../scripts/auth-client.js';
  import { markdownToHtml } from '../scripts/md-render.js';

  const gate = document.getElementById('codex-gate');
  const offline = document.getElementById('codex-offline');
  const terminal = document.getElementById('codex-terminal');
  const output = document.getElementById('codex-output');
  const form = document.getElementById('codex-form');
  const input = document.getElementById('codex-input');
  const sendBtn = document.getElementById('codex-send');
  const stopBtn = document.getElementById('codex-stop');
  const languageDialog = document.getElementById('ai-language-dialog');
  const promptPanel=document.querySelector('.learning-prompts');
  const aiPage=document.querySelector('.codex-page'),expandButton=document.getElementById('ai-expand');
  let expanded=false;
  function updateExpandControl(){
    const label=t(expanded?'gemini.restore':'gemini.expand');expandButton.setAttribute('aria-label',label);expandButton.title=label;expandButton.setAttribute('aria-pressed',String(expanded));
    expandButton.querySelector('[data-expand-icon]').toggleAttribute('hidden',expanded);expandButton.querySelector('[data-restore-icon]').toggleAttribute('hidden',!expanded);
  }
  function setExpanded(value){expanded=value;aiPage.classList.toggle('is-fullscreen',expanded);document.documentElement.classList.toggle('kcis-ai-fullscreen',expanded);updateExpandControl();}
  expandButton.addEventListener('click',()=>setExpanded(!expanded));
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&expanded&&!document.querySelector('dialog[open]')){setExpanded(false);expandButton.focus();}});
  let responseLanguage = null;
  const extraCopy={en:{},'zh-TW':{'gemini.welcome':'我是 KCIS AI，可以協助你查找、整理校內文件與 AI 論壇的解決紀錄。','gemini.firstReplyNote':'第一次 AI 回覆可能需要約 10–15 秒。'}};
  function t(key,vars={}){
    const language=responseLanguage||'en';let text=extraCopy[language][key]||(language==='zh-TW'?zh[key]:en[key])||en[key]||key;
    for(const [name,value] of Object.entries(vars))text=text.replaceAll(`{${name}}`,String(value));return text;
  }
  function applyConversationLanguage(){
    document.querySelector('.codex-page')?.setAttribute('lang',responseLanguage);
    document.querySelectorAll('.codex-page [data-i18n]').forEach(element=>element.textContent=t(element.getAttribute('data-i18n')));
    input.placeholder=t('gemini.placeholder');input.setAttribute('aria-label',t('gemini.placeholder'));
    for(const [button,key] of [[sendBtn,'gemini.send'],[stopBtn,'gemini.stop']]){button.setAttribute('aria-label',t(key));button.title=t(key);}
    document.getElementById('learning-prompts-reset').setAttribute('aria-label',responseLanguage==='en'?'Refresh options':'更新選項');
    document.getElementById('ai-language-current').textContent=responseLanguage==='en'?'EN':'中文';
    resetLearningPrompts();
    updateExpandControl();
  }
  function askLanguage(){if(!languageDialog.open)languageDialog.showModal();}
  languageDialog.addEventListener('cancel',event=>event.preventDefault());
  document.querySelectorAll('[data-ai-language]').forEach(button=>button.addEventListener('click',()=>{
    responseLanguage=button.dataset.aiLanguage;applyConversationLanguage();languageDialog.close();void init();
  }));
  document.getElementById('ai-language-change').addEventListener('click',()=>{if(!running)askLanguage();});
  window.addEventListener('pageshow',event=>{if(event.persisted&&!running)askLanguage();});

  let selectedPrompts=[];
  function resetLearningPrompts(){
    const container=document.getElementById('learning-prompts-list');if(!container)return;
    const pair=pickLearningPrompts(selectedPrompts);selectedPrompts=pair.map(item=>item.id);container.replaceChildren();
    for(const item of pair){const prompt=localizeLearningPrompt(item,responseLanguage||'en');const button=document.createElement('button');button.type='button';button.className='learning-prompt';button.setAttribute('aria-label',prompt.label);button.insertAdjacentHTML('afterbegin',learningPromptIcon(item.id));const label=document.createElement('span');label.textContent=prompt.label;button.append(label);button.onclick=()=>{if(running)return;input.value='';void sendMessage(prompt.text,null,prompt.question);};container.append(button);}
  }
  document.getElementById('learning-prompts-reset')?.addEventListener('click',resetLearningPrompts);
  resetLearningPrompts();

  let abortController = null;
  let running = false;
  let fixedModel = 'gemini-3.1-flash-lite';
  /** @type {{ role: string, content: string }[]} */
  let chatHistory = [];
  let failedAttempt = null;


  function pageBase() {
    return document.documentElement.dataset.base || '/WikiNB-KCIS/';
  }

  function setBubbleText(bubble, text, role = 'assistant') {
    if (!bubble) return;
    if (role === 'assistant') {
      bubble.classList.add('codex-md', 'wiki-content');
      bubble.innerHTML = markdownToHtml(String(text ?? ''), {
        base: pageBase(),
        linkifyWiki: true,
      });
    } else {
      bubble.classList.remove('codex-md', 'wiki-content');
      bubble.textContent = text;
    }
  }

  function appendLine(text, role = 'assistant') {
    const line = document.createElement('div');
    line.className = `codex-line codex-line-${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'codex-bubble';
    setBubbleText(bubble, text, role);
    line.appendChild(bubble);
    output?.appendChild(line);
    output?.scrollTo({ top: output.scrollHeight, behavior: 'smooth' });
    return line;
  }

  function startElapsedTimer() {
    const startedAt = Date.now();
    const line = appendLine('0s', 'system');
    const bubble = line.querySelector('.codex-bubble');
    const id = setInterval(() => {
      const sec = Math.floor((Date.now() - startedAt) / 1000);
      if (bubble) bubble.textContent = `${sec}s`;
    }, 1000);
    return {
      line,
      stop() {
        clearInterval(id);
        const sec = Math.floor((Date.now() - startedAt) / 1000);
        if (bubble) bubble.textContent = t('gemini.totalTime', { sec });
        return sec;
      },
    };
  }

  function formatElapsed(ms) {
    const s = Math.floor(ms / 1000);
    const m = Math.floor(s / 60);
    const rem = s % 60;
    return m > 0 ? `${m}m ${String(rem).padStart(2, '0')}s` : `${rem}s`;
  }

  function setRunning(isRunning) {
    running = isRunning;
    if (sendBtn) sendBtn.disabled = isRunning;
    document.getElementById('ai-language-change').disabled=isRunning;
    document.querySelectorAll('.learning-prompts button').forEach(button=>button.disabled=isRunning);
    document.querySelectorAll('.codex-retry').forEach(button=>button.disabled=isRunning);
    if (stopBtn) {
      stopBtn.disabled = !isRunning;
      stopBtn.hidden = !isRunning;
      stopBtn.setAttribute('aria-label',t('gemini.stop'));
    }
    input?.toggleAttribute('disabled', isRunning);
  }

  async function loadModels(isCurrent=()=>true) {
    try {
      const data = await fetchCodexModels();
      if(!isCurrent())return;
      fixedModel = data.defaultModel || data.models?.[0]?.id || fixedModel;
      if (data.error) appendLine(uiError({message:data.error},t('gemini.connectFail')), 'error');
    } catch (err) {
      if(!isCurrent())return;
      appendLine(uiError(err,t('gemini.connectFail')), 'error');
    }
  }

  function showOffline(){
    gate?.classList.add('hidden');terminal?.classList.add('hidden');
    if(!offline)return;
    offline.replaceChildren(document.createTextNode(t('gemini.apiOffline')));
    const retry=document.createElement('button');retry.type='button';retry.className='learning-prompt codex-retry';retry.textContent=chatMessage('retry',responseLanguage);retry.onclick=()=>void init(true);offline.append(retry);offline.classList.remove('hidden');
  }
  const initialization=createChatInitialization(async({isCurrent})=>{
    const me = await fetchMe({timeoutMs:10000}).catch(() => ({ authenticated: false,offline:true }));
    if(!isCurrent())return false;
    if (!me.authenticated) {
      if(me.offline)showOffline();
      else{offline?.classList.add('hidden');terminal?.classList.add('hidden');gate?.classList.remove('hidden');}
      return false;
    }
    const health = await checkAuthHealth();
    if(!isCurrent())return false;
    if (!health.online) {
      showOffline();return false;
    }
    gate?.classList.add('hidden');
    offline?.classList.add('hidden');
    terminal?.classList.remove('hidden');
    await loadModels(isCurrent);
    if(!isCurrent())return false;
    onLocaleChange();
    input?.focus();
    return true;
  });
  async function init(recheck=false) {
    if(!responseLanguage)return;
    return initialization.request(recheck);
  }

  stopBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!running) return;
    stopBtn.disabled = true;
    stopBtn.setAttribute('aria-label',t('gemini.stopping'));
    try {
      await stopCodex();
    } catch {
      /* ignore */
    }
    abortController?.abort();
  });

  async function sendMessage(msg,retry=null,displayMessage=msg){
    if (running || !responseLanguage) return;
    if (!msg) return;
    failedAttempt?.button?.remove();failedAttempt=null;
    retry?.errorLine?.remove();retry?.timerLine?.remove();
    promptPanel.hidden=true;
    const userLine=retry?.userLine||appendLine(displayMessage,'user');
    const requestHistory=retry?.history||chatHistory.slice(-16);

    abortController = new AbortController();
    setRunning(true);
    const timer = startElapsedTimer();

    const progress = document.createElement('div');
    progress.className = 'codex-line codex-line-system';
    const progressBubble = document.createElement('div');
    progressBubble.className = 'codex-bubble';
    progressBubble.textContent = t('gemini.starting');
    progress.appendChild(progressBubble);
    output?.appendChild(progress);

    const liveWrap = document.createElement('div');
    liveWrap.className = 'codex-line codex-line-live';
    const liveBubble = document.createElement('div');
    liveBubble.className = 'codex-bubble';
    liveWrap.appendChild(liveBubble);
    output?.appendChild(liveWrap);

    let liveText = '';
    try {
      const result = await codexChatStream(
        msg,
        (ev) => {
          if (ev.type === 'status' || ev.type === 'event') {
            progressBubble.textContent = chatMessage(ev.code,responseLanguage,ev.message==='Connecting…'?chatMessage('connecting',responseLanguage):uiError({message:ev.message || ev.summary},t('gemini.working')));
          } else if (ev.type === 'delta' && ev.text) {
            progress.hidden=true;
            liveText += ev.text;
            setBubbleText(liveBubble, liveText, 'assistant');
            output?.scrollTo({ top: output.scrollHeight });
          }
        },
        {
          model: fixedModel,
          reasoningEffort: 'default',
          signal: abortController.signal,
          history: requestHistory,
          responseLanguage,
        },
      );

      timer.stop();
      progress.remove();
      const finalText = result.answer || liveText || t('gemini.noResponse');
      chatHistory=completedChatHistory(chatHistory,msg,result);

      liveWrap.className = `codex-line ${result.stopped ? 'codex-line-system' : 'codex-line-assistant'}`;
      setBubbleText(liveBubble, finalText, result.stopped ? 'system' : 'assistant');
      if(!result.stopped)appendLine(t('gemini.done', { time: formatElapsed(result.elapsedMs || 0) }), 'system');
    } catch (err) {
      timer.stop();
      progress.remove();
      liveWrap.remove();
      if (err?.name !== 'AbortError') {
        const errorLine=appendLine(chatMessage(err.code,responseLanguage,uiError(err,t('gemini.runFailed'))),'error');
        if(err.retryable!==false){
          const button=document.createElement('button');button.type='button';button.className='learning-prompt codex-retry';button.textContent=chatMessage('retry',responseLanguage);
          const attempt={message:msg,userLine,history:requestHistory,errorLine,timerLine:timer.line,button};failedAttempt=attempt;
          button.onclick=()=>{if(!running&&failedAttempt===attempt)void sendMessage(attempt.message,attempt);};
          errorLine.append(button);
        }
      } else appendLine(t('gemini.stopped'), 'system');
    } finally {
      setRunning(false);
      output?.append(promptPanel);promptPanel.hidden=false;
      abortController = null;
      input?.removeAttribute('disabled');
      input?.focus();
    }
  }
  form?.addEventListener('submit',event=>{
    event.preventDefault();if(running||!responseLanguage)return;
    const message=input?.value?.trim();if(!message)return;input.value='';void sendMessage(message);
  });

  document.addEventListener('wikinb:auth-change', (event) => {
    if (event.detail?.loggedIn) void init(true);else{initialization.invalidate();abortController?.abort();chatHistory=[];failedAttempt=null;setExpanded(false);offline?.classList.add('hidden');terminal?.classList.add('hidden');gate?.classList.remove('hidden');for(const line of [...output.children])if(line.id!=='codex-intro'&&line!==promptPanel)line.remove();output.append(promptPanel);promptPanel.hidden=false;}
  });
  askLanguage();
</script>
