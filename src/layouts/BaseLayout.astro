---
import '../styles/global.css';
import Header from '../components/Header.astro';
import DecorBackground from '../components/DecorBackground.astro';
import sites from '../../config/sites.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = sites.brand.tagline } = Astro.props;
const brand = sites.brand.name;
const fullTitle =
  title === brand || title === 'WikiNB' || title === sites.brand.shortName
    ? title === 'WikiNB' || title === sites.brand.shortName
      ? 'WikiNB · KCIS'
      : title
    : `${title} · WikiNB KCIS`;
const brandImage = 'https://kainnne.com/brand/kainnne-mark.png';
const pageUrl = new URL(Astro.url.pathname, 'https://wikinb.kcis.kainnne.com').href;

const authJson = JSON.stringify({
  url:
    import.meta.env.PUBLIC_AUTH_URL ||
    sites.auth?.url ||
    'http://127.0.0.1:8790',
  productionUrl:
    import.meta.env.PUBLIC_AUTH_PRODUCTION_URL ||
    sites.auth?.productionUrl ||
    '',
  allowedEmailDomain: sites.auth?.allowedEmailDomain || 'kcis.com.tw',
});
---

<!doctype html>
<html lang="en" translate="no" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <meta name="googlebot" content="notranslate" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={brandImage} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Kainnne flowing ribbon K brand mark" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={brandImage} />
    <link rel="icon" type="image/png" href={brandImage} />
    <link rel="apple-touch-icon" href={brandImage} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <title>{fullTitle}</title>
    <script id="auth-config" type="application/json" set:html={authJson}></script>
  </head>
  <body>
    <div class="kc-shell">
      <script>
        const trial=import.meta.env.PUBLIC_TRIAL_URL;
        if(trial&&!['localhost','127.0.0.1'].includes(location.hostname)&&new URL(trial).origin!==location.origin)location.replace(new URL('library'+location.pathname+location.search+location.hash,trial).href);
      </script>
      <DecorBackground />
      <Header />
      <main class="mx-auto max-w-6xl px-4 pb-16 pt-24 md:px-8">
        <slot />
      </main>
    </div>
  </body>
</html>
